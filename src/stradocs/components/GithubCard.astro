---
import { Icon } from '@astrojs/starlight/components';
import { readFile, writeFile, mkdir } from "node:fs/promises";
import { existsSync } from "node:fs";
import path from "node:path";

interface Props {
  repo: string;
  caption?: string;
}
const { repo, caption } = Astro.props;

const cacheDir = path.join(process.cwd(), ".cache");
const cachePath = path.join(cacheDir, `repo-${repo.replaceAll("/", "-")}.json`);
let data: any = null;

try {
  if (existsSync(cachePath)) {
    const raw = await readFile(cachePath, "utf-8");
    const j = JSON.parse(raw);
    if (Date.now() - new Date(j.at).getTime() < 6 * 60 * 60 * 1000) data = j.data;
  }
  if (!data) {
    const res = await fetch(`https://api.github.com/repos/${repo}`, {
      headers: {
        "User-Agent": "Stradocs",
        Accept: "application/vnd.github+json",
        ...(import.meta.env.GITHUB_TOKEN ? { Authorization: `Bearer ${import.meta.env.GITHUB_TOKEN}` } : {}),
      },
    });
    if (res.ok) {
      const r = await res.json();
      data = { name: r.full_name, desc: r.description, stars: r.stargazers_count, lang: r.language, url: r.html_url };
      try {
        if (!existsSync(cacheDir)) await mkdir(cacheDir, { recursive: true });
        await writeFile(cachePath, JSON.stringify({ data, at: new Date().toISOString() }));
      } catch {}
    }
  }
} catch {}

const fmt = (n: number) => n >= 1000 ? `${(n/1000).toFixed(n >= 10000 ? 0 : 1)}k` : `${n}`;
---

{data && (
  <a href={data.url} target="_blank" rel="noopener noreferrer" class="repo-card">
    <div class="repo-head">
      <Icon name="github" size="1.15rem" />
      <strong class="repo-name">{data.name}</strong>
      <span class="repo-stars">
        <Icon name="star" size="0.9rem" /> {fmt(data.stars)}
      </span>
    </div>
    <p class="repo-desc">{caption || data.desc || "View repository on GitHub."}</p>
    <div class="repo-foot">
      {data.lang && 
        <span class="repo-lang">
          <span class="dot"></span>
          {data.lang}
        </span>}
      <span class="repo-link">github.com/{data.name} <Icon name="external" size="0.8rem" /></span>
    </div>
  </a>
)}

<style>
.repo-card {
  display: block;
  border: 1px solid var(--sl-color-hairline);
  border-radius: 0.75rem;
  padding: 1rem 1.15rem;
  background: var(--sl-color-gray-6);
  text-decoration: none;
  color: var(--sl-color-text);
  transition: all .15s;
  margin-block: 1rem;
  & .repo-head { 
    display: flex; 
    align-items: center; 
    gap: 0.55rem; 
    & .repo-name { color: var(--sl-color-white); font-size: 0.95rem; }
    & .repo-stars { margin-left: auto; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.8rem; color: var(--sl-color-gray-2); }
  }
  & .repo-desc { 
    margin: 0.55rem 0 0.75rem; 
    font-size: 0.88rem; 
    line-height: 1.5; 
    color: var(--sl-color-gray-2); 
    display: -webkit-box; 
    -webkit-line-clamp: 2; 
    -webkit-box-orient: vertical; 
    overflow: hidden; 
  }
  & .repo-foot { 
    display: flex; 
    align-items: center; 
    gap: 0.8rem; 
    font-size: 0.78rem; 
    color: var(--sl-color-gray-3); 
    & .repo-lang { 
      display: inline-flex; 
      align-items: center; 
      gap: 0.3rem;
      & .dot { width: 8px; height: 8px; border-radius: 999px; background: var(--sl-color-accent); } 
    }
    & .repo-link { margin-left: auto; display: inline-flex; align-items: center; gap: 0.25rem; opacity: 0.7; }
  }
}

:global([data-theme="light"]) .repo-card {
  background: var(--sl-color-gray-7);
}

@media (hover: hover) {
  .repo-card:hover { 
    border-color: var(--sl-color-gray-3); 
    transform: translateY(-1px);
    & .repo-link { opacity: 1; } 
  }
}
</style>