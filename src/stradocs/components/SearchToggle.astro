---
import { Icon } from "@astrojs/starlight/components";
---

<button
  data-open-modal
  type="button"
  class="search-trigger search-trigger--desktop"
  aria-label={Astro.locals.t('search.label')}
  onclick="window.openOramaSearch?.()"
  aria-keyshortcuts="Control+K"
>
  <Icon name="magnifier" />
  <span class="search-trigger__label" aria-hidden="true">{Astro.locals.t('search.label')}</span>
  <kbd class="search-trigger__kbd">
		<kbd>{Astro.locals.t('search.ctrlKey')}</kbd><kbd>K</kbd>
	</kbd>
</button>

<style is:global>
  .search-trigger--desktop {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 22rem;
    height: 2.5rem;
    padding-inline: 0.75rem 0.5rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-3);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    cursor: pointer;
    font-size: var(--sl-text-sm);
    transition:
      color 0.15s ease;
  }
  .search-trigger--desktop:hover {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-gray-1);
    background: var(--sl-color-gray-6);
  }
  .search-trigger--desktop:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .search-trigger__label {
    flex: 1;
    text-align: left;
  }

  .search-trigger__kbd {
    display: inline-flex;
    align-items: center;
    font-family: var(--__sl-font);
    padding-inline: 0.375rem;
		padding-block: 0.0125rem;
    font-size: var(--sl-text-2xs);
    gap: 0.25em;
    color: var(--sl-color-gray-3);
    background-color: var(--sl-color-gray-6);
		box-shadow: inset 0 -1px 0 rgb(0 0 0 / 18%);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
  }

  @media (max-width: 50rem) {
    .search-trigger--desktop { display: none; }
  }
</style>

<script is:inline>
	(() => {
		const openBtn = document.querySelector('button[data-open-modal]');
		const shortcut = openBtn?.querySelector('kbd');
		if (!openBtn || !(shortcut instanceof HTMLElement)) return;
		const platformKey = shortcut.querySelector('kbd');
		if (platformKey && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
			platformKey.textContent = '⌘';
			openBtn.setAttribute('aria-keyshortcuts', 'Meta+K');
		}
		shortcut.style.display = '';
	})();
</script>