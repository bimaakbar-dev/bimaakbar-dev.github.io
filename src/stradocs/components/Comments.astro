---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const { lang } = Astro.locals.starlightRoute;

const repo = 'bimaakbar-dev/bimaakbar-dev.github.io';
const repoId = 'R_kgDOUKMOFQ';
const category = 'General';
const categoryId = 'DIC_kwDOUKMOFc4DEm1Q';

const baseUrl = 'https://bimaakbar-dev.github.io';
const darkTheme = `${baseUrl}/giscus-theme.css`;
const lightTheme = `${baseUrl}/giscus-theme-light.css`;
---

<section class:list={['comments', className]}>
  <h2 class="comments__title">Komentar</h2>

  <div class="comments__embed">
    <script
	  is:inline
      src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-lang={lang}
      data-loading="lazy"
      crossorigin="anonymous"
      data-theme={lightTheme}
      async
    ></script>
  </div>
</section>

<script is:inline define:vars={{ darkTheme, lightTheme }}>
  (function() {
    /**
    * @type {Element | null}
    */
    let giscusFrame = null;

    function getGiscusTheme() {
      const theme = document.documentElement.dataset.theme || 'dark';
      // @ts-ignore
      return theme === 'dark' ? darkTheme : lightTheme;
    }

    function sendThemeToGiscus() {
      if (!giscusFrame) {
        giscusFrame = document.querySelector('iframe.giscus-frame');
      }
      if (!giscusFrame) return;

      // @ts-ignore
      giscusFrame.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: getGiscusTheme() } } },
        'https://giscus.app'
      );
    }

    window.addEventListener('message', (e) => {
      if (e.origin !== 'https://giscus.app') return;
      if (typeof e.data !== 'object' || !e.data.giscus) return;
      sendThemeToGiscus();
    });

    new MutationObserver(sendThemeToGiscus).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  })();
</script>

<style is:global>
  .comments {
    max-width: 50rem;
    margin-inline: auto;
    width: 100%;
    border-top: 1px solid var(--sl-color-gray-5);
    padding-top: var(--sl-content-gap-y);
    padding-inline: 0;
  }

  .comments__title {
    font-size: var(--sl-text-h3);
    font-weight: 600;
    color: var(--sl-color-white);
    margin-bottom: 1.5rem;
  }

  .comments__embed {
    min-height: 15rem;
  }
  
  [data-has-hero] .comments {
    display: none;
  }
</style>
