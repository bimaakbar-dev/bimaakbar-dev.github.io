---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const repo = 'bimaakbar-dev/bimaakbar-dev.github.io';
const repoId = 'R_kgDOUKMOFQ';
const category = 'Comments' || 'General';
const categoryId = 'DIC_kwDOUKMOFc4DEm1Q';

const giscusTheme = '/giscus-theme.css';
---

<section class:list={['comments', className]}>
  <h2 class="comments__title">Komentar</h2>

  <div class="comments__embed">
    <script
      src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="og:title"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-lang="id"
      data-loading="lazy"
      crossorigin="anonymous"
      data-theme="preferred_color_scheme"
      async
    ></script>
  </div>
</section>

<style>
  .comments {
    max-width: 50rem;
    margin-inline: auto;
    width: 100%;
    align-items: center;
    border-top: 1px solid var(--sl-color-gray-5);
    padding-top: var(--sl-content-gap-y);
    padding-inline: 0;
  }

  .comments__title {
    font-size: var(--sl-text-h3);
    font-weight: 600;
    color: var(--sl-color-white);
    margin-bottom: 1.5rem;
  }

  .comments__embed {
    min-height: 15rem;
  }
</style>