---
interface Topic {
  name: string;
  href: string;
  icon?: 'game' | 'anime' | 'modding' | string;
  description?: string;
  large?: boolean;
}

interface Props {
  topics: Topic[];
  label?: string;
}

const { topics, label = 'Topik' } = Astro.props;

const ICONS: Record<string, string> = {
  game: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" x2="10" y1="11" y2="11"/><line x1="8" x2="8" y1="9" y2="13"/><line x1="15" x2="15.01" y1="12" y2="12"/><line x1="18" x2="18.01" y1="10" y2="10"/><path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.152A4 4 0 0 0 17.32 5"/></svg>`,
  anime: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>`,
  modding: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
};

const getIcon = (name?: string) => (name && ICONS[name]) || '';
---

<nav class="topic-grid" aria-label={label}>
  {topics.map((topic: any) => (
    <a href={topic.href} class:list={['tile', topic.large && 'is-large']}>
      <article>
        {topic.icon && (
          <span class="icon" set:html={getIcon(topic.icon)} />
        )}
        <h3>{topic.name}</h3>
        {topic.description && <p>{topic.description}</p>}
      </article>
    </a>
  ))}
</nav>

<style>
    .topic-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
      border-radius: 0.75rem;
      overflow: hidden;
      margin-top: 1.5rem;
    }

    .tile {
      flex: 1 1 10rem;
      min-width: 10rem;
      text-decoration: none;
      color: inherit;
      -webkit-tap-highlight-color: transparent;
    }

    .tile.is-large {
      flex-basis: 100%;
    }

    .tile article {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 1.5rem 1rem;
      height: 100%;
      background-color: var(--sl-color-gray-6);
    }

    @media (hover: hover) {
      .tile:hover article {
        background-color: var(--sl-color-gray-5);
      }
    }

    .tile:focus-visible article {
      outline: 2px solid var(--sl-color-accent);
      outline-offset: -2px;
    }

    .icon {
      display: inline-flex;
      width: 1.75rem;
      height: 1.75rem;
      color: var(--sl-color-gray-2);
    }

    .icon :global(svg) {
      width: 100%;
      height: 100%;
    }

    h3 {
      margin: 0;
      font-size: var(--sl-text-body);
      font-weight: 600;
      color: var(--sl-color-white);
      text-align: center;
    }

    p {
      margin: 0;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
      text-align: center;
    }

    @media (prefers-reduced-motion: reduce) {
      .tile article { transition: none; }
    }
</style>