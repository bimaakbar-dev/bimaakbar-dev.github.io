---
import { Icon } from "@astrojs/starlight/components";
import { readFile, writeFile, mkdir } from "node:fs/promises";
import { existsSync } from "node:fs";
import path from "node:path";

interface Props {
  repo: string;
}

const { repo } = Astro.props;

const cacheDir  = path.join(process.cwd(), ".cache");
const cachePath = path.join(cacheDir, `stars-${repo.replaceAll("/", "-")}.json`);

let stars = 0;

try {
  if (existsSync(cachePath)) {
    const json = JSON.parse(await readFile(cachePath, "utf-8"));
    if (Date.now() - new Date(json.at).getTime() < 6 * 60 * 60 * 1000) {
      stars = json.stars;
    }
  }

  if (!stars) {
    const res = await fetch(`https://api.github.com/repos/${repo}`, {
      headers: {
        "User-Agent": "Stradocs",
        Accept: "application/vnd.github+json",
        ...(import.meta.env.GH_TOKEN
          ? { Authorization: `Bearer ${import.meta.env.GH_TOKEN}` }
          : {}),
      },
    });

    if (res.ok) {
      stars = (await res.json()).stargazers_count ?? 0;
      try {
        if (!existsSync(cacheDir)) await mkdir(cacheDir, { recursive: true });
        await writeFile(
          cachePath,
          JSON.stringify({ stars, at: new Date().toISOString() }),
        );
      } catch {}
    }
  }
} catch {}

const fmt = (n: number) =>
  n >= 1000 ? `${(n / 1000).toFixed(n >= 10_000 ? 0 : 1)}k` : `${n}`;
---

<a
  href={`https://github.com/${repo}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={stars ? `${stars} stars on GitHub` : "View on GitHub"}
>
  <Icon name="github" />
  <p>Star</p>
  <span class="counter" aria-hidden="true">{stars ? fmt(stars) : "-"}</span>
</a>

<style>
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.25em 0.75em;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 99rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    text-decoration: none;
    vertical-align: middle;
    & > svg {
      flex-shrink: 0;
      width: 1.125em;
      height: 1.125em;
    }
    &:hover {
      background: var(--sl-color-gray-6);
    }
  }
  [data-theme='light'] a:hover {
    background: var(--sl-color-gray-7);
  }
</style>