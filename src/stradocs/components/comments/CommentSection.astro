---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const serverURL = 'https://bimaakbar-dev-comments.bimasaktiakbarr.workers.dev/api';
const path = Astro.url.pathname;
---

<section
  class:list={['c-comments', className]}
  data-comments
  data-server={serverURL}
  data-path={path}
>
  <header class="c-comments__header">
    <div class="c-comments__header-left">
      <span class="c-comments__label">Diskusi</span>
      <span class="c-comments__count" data-count>—</span>
    </div>
    <div class="c-comments__auth" data-auth hidden>
      <img class="c-comments__auth-avatar" data-user-avatar alt="" />
      <span class="c-comments__auth-name" data-user-name></span>
      <button type="button" class="c-comments__auth-btn" data-logout>Keluar</button>
    </div>
    <div class="c-comments__auth-prompt" data-auth-prompt>
      <button type="button" class="c-btn c-btn--ghost c-btn--xs" data-open-login>Masuk</button>
      <button type="button" class="c-btn c-btn--ghost c-btn--xs" data-open-register>Daftar</button>
    </div>
  </header>

  <form class="c-comments__form" data-form>
    <p class="c-comments__form-to" data-form-to hidden></p>

    <div class="c-form__fields">
      <div class="c-form__row">
        <div class="c-form__field">
          <label class="c-form__label" for="c-nick">Nama <span aria-hidden="true">*</span></label>
          <input
            id="c-nick"
            type="text"
            name="nick"
            placeholder="Nama tampilan"
            maxlength="50"
            required
            autocomplete="nickname"
            data-field="nick"
          />
        </div>
        <div class="c-form__field">
          <label class="c-form__label" for="c-mail">Email <span class="c-form__optional">opsional</span></label>
          <input
            id="c-mail"
            type="email"
            name="mail"
            placeholder="Untuk gravatar"
            autocomplete="email"
            data-field="mail"
          />
        </div>
      </div>

      <div class="c-form__field">
        <label class="c-form__label" for="c-link">Website <span class="c-form__optional">opsional</span></label>
        <input
          id="c-link"
          type="url"
          name="link"
          placeholder="https://"
          autocomplete="url"
          data-field="link"
        />
      </div>

      <div class="c-form__field c-form__field--textarea">
        <label class="c-form__label" for="c-comment">Komentar <span aria-hidden="true">*</span></label>
        <textarea
          id="c-comment"
          name="comment"
          placeholder="Tulis komentar… Markdown didukung."
          rows="4"
          required
          data-field="comment"
        ></textarea>
        <span class="c-form__hint">Markdown: **bold**, *italic*, `code`, > kutipan</span>
      </div>
    </div>

    <input
      type="text"
      name="hp"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="c-comments__hp"
    />

    <div class="c-comments__actions">
      <p class="c-comments__status" data-status role="status" aria-live="polite"></p>
      <div class="c-comments__btns">
        <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-cancel hidden>Batal balas</button>
        <button type="submit" class="c-btn c-btn--sm c-btn--primary" data-submit>Kirim</button>
      </div>
    </div>
  </form>

  <div class="c-comments__list" data-list>
    <div class="c-comments__skeleton" aria-hidden="true">
      <div class="c-skel"><div class="c-skel__avatar"></div><div class="c-skel__lines"><div class="c-skel__line c-skel__line--short"></div><div class="c-skel__line"></div><div class="c-skel__line c-skel__line--med"></div></div></div>
      <div class="c-skel"><div class="c-skel__avatar"></div><div class="c-skel__lines"><div class="c-skel__line c-skel__line--med"></div><div class="c-skel__line"></div></div></div>
    </div>
  </div>

  <div class="c-comments__pagination" data-pagination hidden></div>

  <dialog class="c-auth-modal" data-auth-modal>
    <div class="c-auth-modal__inner">
      <form class="c-auth-modal__form" data-auth-form novalidate>
        <div class="c-auth-modal__head">
          <h3 class="c-auth-modal__title" data-auth-title>Masuk</h3>
          <button type="button" class="c-auth-modal__close" data-auth-close aria-label="Tutup">
            <svg viewBox="0 0 16 16" fill="none" width="14" height="14" aria-hidden="true">
              <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <div class="c-auth-modal__fields">
          <div class="c-form__field" data-nick-wrap>
            <label class="c-form__label" for="m-nick">Nama</label>
            <input id="m-nick" type="text" name="nick" placeholder="Nama tampilan" autocomplete="nickname" data-auth-field="nick" hidden />
          </div>
          <div class="c-form__field">
            <label class="c-form__label" for="m-email">Email</label>
            <input id="m-email" type="email" name="email" placeholder="kamu@email.com" required autocomplete="email" data-auth-field="email" />
          </div>
          <div class="c-form__field">
            <label class="c-form__label" for="m-pw">Password</label>
            <input id="m-pw" type="password" name="password" placeholder="Min. 6 karakter" required minlength="6" autocomplete="current-password" data-auth-field="password" />
          </div>
        </div>

        <p class="c-auth-modal__msg" data-auth-msg role="status" aria-live="polite"></p>

        <div class="c-auth-modal__foot">
          <button type="submit" class="c-btn c-btn--primary c-btn--sm c-btn--full" data-auth-submit>Masuk</button>
          <p class="c-auth-modal__switch">
            <span data-switch-text>Belum punya akun?</span>
            <button type="button" class="c-link" data-switch-mode>Daftar</button>
          </p>
        </div>
      </form>
    </div>
  </dialog>
</section>

<script>
  import { WalineClient, type WalineComment, type WalineUser } from '~/utils/waline';

  function bootCommentSection(root: HTMLElement) {
    if (root.dataset.booted) return;
    root.dataset.booted = '1';

    const serverURL = root.dataset.server!;
    const path = root.dataset.path!;
    const client = new WalineClient(serverURL);

    const $ = <T extends HTMLElement = HTMLElement>(sel: string) =>
      root.querySelector<T>(sel);

    const form = $<HTMLFormElement>('[data-form]')!;
    const listEl = $<HTMLElement>('[data-list]')!;
    const statusEl = $<HTMLElement>('[data-status]')!;
    const countEl = $<HTMLElement>('[data-count]')!;
    const submitBtn = $<HTMLButtonElement>('[data-submit]')!;
    const cancelBtn = $<HTMLButtonElement>('[data-cancel]')!;
    const formToEl = $<HTMLElement>('[data-form-to]')!;

    const authBar = $<HTMLElement>('[data-auth]')!;
    const userAvatar = $<HTMLImageElement>('[data-user-avatar]')!;
    const userName = $<HTMLElement>('[data-user-name]')!;
    const logoutBtn = $<HTMLButtonElement>('[data-logout]')!;
    const authPrompt = $<HTMLElement>('[data-auth-prompt]')!;
    const openLogin = $<HTMLButtonElement>('[data-open-login]')!;
    const openRegister = $<HTMLButtonElement>('[data-open-register]')!;

    const modal = $<HTMLDialogElement>('[data-auth-modal]')!;
    const modalForm = $<HTMLFormElement>('[data-auth-form]')!;
    const modalTitle = $<HTMLElement>('[data-auth-title]')!;
    const modalMsg = $<HTMLElement>('[data-auth-msg]')!;
    const modalSubmit = $<HTMLButtonElement>('[data-auth-submit]')!;
    const modalClose = $<HTMLButtonElement>('[data-auth-close]')!;
    const nickInput = modalForm.querySelector<HTMLInputElement>('[data-auth-field="nick"]')!;
    const nickWrap = modalForm.querySelector<HTMLElement>('[data-nick-wrap]')!;
    const switchText = $<HTMLElement>('[data-switch-text]')!;
    const switchMode = $<HTMLButtonElement>('[data-switch-mode]')!;

    let currentUser: WalineUser | null = null;
    // pid/rid mirror WalineComment.objectId, which is a string — not a number.
    let replyTo: { pid: string; rid: string; nick: string } | null = null;
    let currentPage = 1;
    let authMode: 'login' | 'register' = 'login';

    // ── Liked-comment tracking (per-browser, so the same visitor can't spam-like) ──
    const LIKED_KEY = 'c-comments-liked';
    function getLikedIds(): Set<string> {
      try {
        const raw = localStorage.getItem(LIKED_KEY);
        return new Set(raw ? (JSON.parse(raw) as string[]) : []);
      } catch {
        return new Set();
      }
    }
    function setLiked(id: string, liked: boolean) {
      const ids = getLikedIds();
      if (liked) ids.add(id);
      else ids.delete(id);
      try {
        localStorage.setItem(LIKED_KEY, JSON.stringify([...ids]));
      } catch {}
    }

    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!
      );

    const fmtDate = (ts: number) => {
      const d = new Date(ts);
      const diff = (Date.now() - d.getTime()) / 1000;
      if (diff < 60) return 'baru saja';
      if (diff < 3600) return `${Math.floor(diff / 60)} mnt lalu`;
      if (diff < 86400) return `${Math.floor(diff / 3600)} jam lalu`;
      if (diff < 604800) return `${Math.floor(diff / 86400)} hr lalu`;
      return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
    };

    function commentItem(c: WalineComment, isReply = false, depth = 0): string {
      const canDelete =
        currentUser &&
        (currentUser.type === 'administrator' || currentUser.objectId === c.user_id);
      const canPin = currentUser?.type === 'administrator' && !isReply;

      const rid = isReply ? (c.rid ?? c.objectId) : c.objectId;
      const liked = getLikedIds().has(c.objectId);
      const likeCount = c.like ?? 0;

      return `
        <article class="c-item${isReply ? ' c-item--reply' : ''}${depth > 1 ? ' c-item--deep' : ''}${c.sticky ? ' c-item--sticky' : ''}" data-comment-id="${c.objectId}">
          <div class="c-item__avatar-wrap">
            <img class="c-item__avatar" src="${esc(c.avatar)}" alt="${esc(c.nick)}" loading="lazy" width="32" height="32" />
            ${c.children?.length ? '<div class="c-item__thread-line" aria-hidden="true"></div>' : ''}
          </div>
          <div class="c-item__body">
            <header class="c-item__header">
              <div class="c-item__meta">
                ${c.sticky ? '<span class="c-item__badge c-item__badge--sticky">📌 Disematkan</span>' : ''}
                ${c.link
                  ? `<a class="c-item__name" href="${esc(c.link)}" target="_blank" rel="noopener nofollow">${esc(c.nick)}</a>`
                  : `<span class="c-item__name">${esc(c.nick)}</span>`
                }
                ${c.type === 'administrator' ? '<span class="c-item__badge c-item__badge--admin">Admin</span>' : ''}
                ${c.status === 'waiting' ? '<span class="c-item__badge c-item__badge--pending">Moderasi</span>' : ''}
                ${c.reply_user ? `<span class="c-item__reply-to" aria-label="membalas ${esc(c.reply_user.nick)}">↩ ${esc(c.reply_user.nick)}</span>` : ''}
              </div>
              <time class="c-item__date" datetime="${new Date(c.time).toISOString()}">${fmtDate(c.time)}</time>
            </header>
            <div class="c-item__content">${c.comment}</div>
            <div class="c-item__actions">
              <button
                type="button"
                class="c-item__action c-item__action--like${liked ? ' is-liked' : ''}"
                data-like="${c.objectId}"
                aria-pressed="${liked}"
                aria-label="Sukai komentar ${esc(c.nick)}"
              >
                <svg viewBox="0 0 16 16" width="12" height="12" fill="${liked ? 'currentColor' : 'none'}" aria-hidden="true">
                  <path d="M8 13.5s-5.5-3.2-5.5-7A3 3 0 0 1 8 4.5 3 3 0 0 1 13.5 6.5c0 3.8-5.5 7-5.5 7Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
                </svg>
                <span data-like-count>${likeCount}</span>
              </button>
              <button
                type="button"
                class="c-item__action"
                data-reply="${c.objectId}"
                data-rid="${rid}"
                data-nick="${esc(c.nick)}"
                aria-label="Balas komentar ${esc(c.nick)}"
              >
                Balas
              </button>
              ${canPin ? `
              <button type="button" class="c-item__action" data-pin="${c.objectId}" data-pinned="${c.sticky ? '1' : '0'}" aria-label="${c.sticky ? 'Lepas sematan' : 'Sematkan komentar'}">
                ${c.sticky ? 'Lepas sematan' : 'Sematkan'}
              </button>` : ''}
              ${canDelete ? `
              <button type="button" class="c-item__action c-item__action--danger" data-delete="${c.objectId}" aria-label="Hapus komentar">
                Hapus
              </button>` : ''}
            </div>
          </div>
        </article>
        ${c.children?.map((child) => commentItem(child, true, depth + 1)).join('') ?? ''}
      `;
    }

    function renderList(comments: WalineComment[]) {
      if (!comments.length) {
        listEl.innerHTML = `
          <div class="c-comments__empty">
            <svg viewBox="0 0 40 40" fill="none" width="36" height="36" aria-hidden="true">
              <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3"/>
              <path d="M14 20h12M14 15h8M14 25h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <p>Belum ada komentar.</p>
            <p class="c-comments__empty-sub">Jadilah yang pertama berdiskusi.</p>
          </div>`;
        return;
      }
      // Sticky root comments float to the top, keeping relative order otherwise.
      const sorted = [...comments].sort((a, b) => (b.sticky ? 1 : 0) - (a.sticky ? 1 : 0));
      listEl.innerHTML = `<div class="c-item-list">${sorted.map((c) => commentItem(c)).join('')}</div>`;
    }

    function setSubmitting(loading: boolean) {
      submitBtn.disabled = loading;
    }

    async function loadComments(page = 1) {
      listEl.innerHTML = `
        <div class="c-comments__skeleton" aria-hidden="true">
          <div class="c-skel"><div class="c-skel__avatar"></div><div class="c-skel__lines"><div class="c-skel__line c-skel__line--short"></div><div class="c-skel__line"></div><div class="c-skel__line c-skel__line--med"></div></div></div>
          <div class="c-skel"><div class="c-skel__avatar"></div><div class="c-skel__lines"><div class="c-skel__line c-skel__line--med"></div><div class="c-skel__line"></div></div></div>
        </div>`;
      try {
        const res = await client.listComments(path, page, 20);
        if (res.errno !== 0) throw new Error(res.errmsg);
        const count = res.data.count ?? 0;
        countEl.textContent = String(count);
        renderList(res.data.data ?? []);
        currentPage = page;
        renderPagination(res.data.totalPages ?? 1, page);
      } catch (e) {
        listEl.innerHTML = `<p class="c-comments__error">Gagal memuat: ${esc(String(e))}</p>`;
      }
    }

    function renderPagination(totalPages: number, current: number) {
      const el = $<HTMLElement>('[data-pagination]')!;
      if (totalPages <= 1) { el.hidden = true; return; }
      el.hidden = false;
      el.innerHTML = `
        ${current > 1 ? `<button type="button" class="c-btn c-btn--ghost c-btn--sm" data-page="${current - 1}">← Sebelumnya</button>` : '<span></span>'}
        <span class="c-pagination__info">${current} / ${totalPages}</span>
        ${current < totalPages ? `<button type="button" class="c-btn c-btn--ghost c-btn--sm" data-page="${current + 1}">Berikutnya →</button>` : '<span></span>'}
      `;
    }

    // ── Form submit ──────────────────────────────────
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      if (fd.get('hp')) return;

      setSubmitting(true);
      statusEl.textContent = '';
      statusEl.removeAttribute('data-state');

      try {
        const res = await client.submitComment({
          comment: String(fd.get('comment') ?? '').trim(),
          nick: String(fd.get('nick') ?? '').trim(),
          mail: String(fd.get('mail') ?? '').trim() || undefined,
          link: String(fd.get('link') ?? '').trim() || undefined,
          url: path,
          pid: replyTo?.pid,
          rid: replyTo?.rid,
          at: replyTo?.nick,
        });

        if (res.errno !== 0) {
          statusEl.textContent = res.errmsg || 'Gagal mengirim.';
          statusEl.setAttribute('data-state', 'error');
        } else {
          const isWaiting = res.data?.status === 'waiting';
          statusEl.textContent = isWaiting ? 'Komentar menunggu moderasi.' : 'Terkirim!';
          statusEl.setAttribute('data-state', isWaiting ? 'warn' : 'success');
          form.reset();
          prefillUserFields();
          cancelReply();
          if (!isWaiting) await loadComments(1);
        }
      } catch {
        statusEl.textContent = 'Terjadi kesalahan jaringan.';
        statusEl.setAttribute('data-state', 'error');
      } finally {
        setSubmitting(false);
      }
    });

    // ── Reply ────────────────────────────────────────
    function setReply(pid: string, rid: string, nick: string) {
      replyTo = { pid, rid, nick };
      formToEl.hidden = false;
      formToEl.textContent = `Membalas @${nick}`;
      cancelBtn.hidden = false;
      form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      (form.querySelector<HTMLTextAreaElement>('[data-field="comment"]'))?.focus();
    }

    function cancelReply() {
      replyTo = null;
      formToEl.hidden = true;
      formToEl.textContent = '';
      cancelBtn.hidden = true;
    }

    cancelBtn.addEventListener('click', cancelReply);

    // ── Delegated list events ────────────────────────
    listEl.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const replyBtn = target.closest<HTMLButtonElement>('[data-reply]');
      const deleteBtn = target.closest<HTMLButtonElement>('[data-delete]');
      const likeBtn = target.closest<HTMLButtonElement>('[data-like]');
      const pinBtn = target.closest<HTMLButtonElement>('[data-pin]');

      if (replyBtn) {
        const pid = replyBtn.dataset.reply;
        const rid = replyBtn.dataset.rid;
        const nick = replyBtn.dataset.nick;
        if (pid && rid && nick) setReply(pid, rid, nick);
      }

      if (deleteBtn) {
        const id = deleteBtn.dataset.delete;
        if (!id) return;
        if (!confirm('Hapus komentar ini?')) return;
        deleteBtn.disabled = true;
        const res = await client.deleteComment(id);
        if (res.errno === 0) await loadComments(currentPage);
        else { alert(res.errmsg || 'Gagal menghapus.'); deleteBtn.disabled = false; }
      }

      if (likeBtn) {
        const id = likeBtn.dataset.like;
        if (!id) return;
        const alreadyLiked = getLikedIds().has(id);
        const nextLiked = !alreadyLiked;
        const countEl = likeBtn.querySelector<HTMLElement>('[data-like-count]')!;
        const current = Number(countEl.textContent) || 0;

        // Optimistic update
        likeBtn.disabled = true;
        likeBtn.classList.toggle('is-liked', nextLiked);
        likeBtn.setAttribute('aria-pressed', String(nextLiked));
        countEl.textContent = String(Math.max(0, current + (nextLiked ? 1 : -1)));

        try {
          const res = await client.likeComment(id, nextLiked);
          if (res.errno === 0) {
            setLiked(id, nextLiked);
          } else {
            // Revert on failure
            likeBtn.classList.toggle('is-liked', alreadyLiked);
            likeBtn.setAttribute('aria-pressed', String(alreadyLiked));
            countEl.textContent = String(current);
          }
        } catch {
          likeBtn.classList.toggle('is-liked', alreadyLiked);
          likeBtn.setAttribute('aria-pressed', String(alreadyLiked));
          countEl.textContent = String(current);
        } finally {
          likeBtn.disabled = false;
        }
      }

      if (pinBtn) {
        const id = pinBtn.dataset.pin;
        if (!id) return;
        const nextPinned = pinBtn.dataset.pinned !== '1';
        pinBtn.disabled = true;
        const res = await client.setSticky(id, nextPinned);
        if (res.errno === 0) await loadComments(currentPage);
        else { alert(res.errmsg || 'Gagal mengubah sematan.'); pinBtn.disabled = false; }
      }
    });

    $<HTMLElement>('[data-pagination]')!.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-page]');
      if (btn) loadComments(Number(btn.dataset.page));
    });

    // ── Auth ─────────────────────────────────────────
    function openAuthModal(mode: 'login' | 'register') {
      authMode = mode;
      const isLogin = mode === 'login';
      modalTitle.textContent = isLogin ? 'Masuk' : 'Buat akun';
      modalSubmit.textContent = isLogin ? 'Masuk' : 'Daftar';
      switchText.textContent = isLogin ? 'Belum punya akun?' : 'Sudah punya akun?';
      switchMode.textContent = isLogin ? 'Daftar' : 'Masuk';
      nickInput.hidden = isLogin;
      nickInput.required = !isLogin;
      nickWrap.hidden = isLogin;
      modalMsg.textContent = '';
      modalMsg.removeAttribute('data-state');
      modalForm.reset();
      modal.showModal();
      // Focus first visible input
      setTimeout(() => {
        const first = modalForm.querySelector<HTMLInputElement>('input:not([hidden])');
        first?.focus();
      }, 50);
    }

    switchMode.addEventListener('click', () => {
      openAuthModal(authMode === 'login' ? 'register' : 'login');
    });

    openLogin.addEventListener('click', () => openAuthModal('login'));
    openRegister.addEventListener('click', () => openAuthModal('register'));
    modalClose.addEventListener('click', () => modal.close());

    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    modalForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(modalForm);
      const email = String(fd.get('email') ?? '');
      const password = String(fd.get('password') ?? '');
      const nick = String(fd.get('nick') ?? '');

      modalSubmit.disabled = true;
      modalMsg.textContent = 'Memproses…';
      modalMsg.removeAttribute('data-state');

      try {
        const res =
          authMode === 'login'
            ? await client.login(email, password)
            : await client.register({ email, password, nick, url: path });

        if (res.errno !== 0) {
          modalMsg.textContent = res.errmsg || 'Gagal.';
          modalMsg.setAttribute('data-state', 'error');
          return;
        }

        if (authMode === 'register') {
          modalMsg.textContent = 'Berhasil! Silakan masuk.';
          modalMsg.setAttribute('data-state', 'success');
          setTimeout(() => openAuthModal('login'), 1000);
          return;
        }

        modal.close();
        await refreshUser();
        await loadComments(1);
      } catch {
        modalMsg.textContent = 'Terjadi kesalahan jaringan.';
        modalMsg.setAttribute('data-state', 'error');
      } finally {
        modalSubmit.disabled = false;
      }
    });

    logoutBtn.addEventListener('click', async () => {
      await client.logout();
      currentUser = null;
      clearUserFields();
      await refreshUser();
    });

    function prefillUserFields() {
      if (!currentUser) return;
      const nickF = form.querySelector<HTMLInputElement>('[data-field="nick"]');
      const mailF = form.querySelector<HTMLInputElement>('[data-field="mail"]');
      if (nickF) nickF.value = currentUser.display_name;
      if (mailF) mailF.value = currentUser.email;
    }

    function clearUserFields() {
      const nickF = form.querySelector<HTMLInputElement>('[data-field="nick"]');
      const mailF = form.querySelector<HTMLInputElement>('[data-field="mail"]');
      if (nickF) nickF.value = '';
      if (mailF) mailF.value = '';
    }

    async function refreshUser() {
      currentUser = await client.getCurrentUser();

      if (currentUser) {
        authBar.hidden = false;
        authPrompt.hidden = true;
        userAvatar.src = currentUser.avatar;
        userName.textContent = currentUser.display_name;
        prefillUserFields();
      } else {
        authBar.hidden = true;
        authPrompt.hidden = false;
      }
    }

    (async () => {
      await refreshUser();
      await loadComments(1);
    })();
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-comments]').forEach(bootCommentSection);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

