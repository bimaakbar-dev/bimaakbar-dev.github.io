---
//@ts-ignore
import type { ImageMetadata } from 'astro';
import { Image } from "astro:assets";

interface Props {
  handle: string;
  name: string;
  cite?: string;
}

const { 
  name, 
  handle, 
  cite 
} = Astro.props;

const avatars = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/testimonials/*.jpg",
);
const avatar = avatars[`../../assets/images/testimonials/${handle}.jpg`];
if (!avatar) {
  throw new Error(`Could not resolve testimonial avatar for @${handle}`);
}
const src = (await avatar()).default;
---

<li class="testimonial sl-flex not-content">
  <blockquote cite={cite}>
    <slot />
  </blockquote>
  <footer class="sl-flex">
    <Image class="avatar" height="48" width="48" {src} alt="" loading='eager' decoding='async' fetchpriority='low' quality='mid' fit='cover' position='center' />
    <div class="cite sl-flex">
      <p class="name">{name}</p>
      {cite && <a href={cite}>@{handle}</a>}
    </div>
  </footer>
</li>

<style>
  li {
    flex-direction: column;
    gap: 1em;
    list-style: none;
    padding: 0;
    & blockquote {
      position: relative;
      text-align: left;
      padding: 0.75rem 1rem;
      border-radius: 0.75rem;
      border-bottom-left-radius: 0;
      border: 1px solid var(--sl-color-hairline);
      background: var(--sl-color-gray-6);
      color: var(--sl-color-white);
      font-size: var(--sl-text-h3);
      line-height: var(--sl-line-height-headings);
      font-weight: 400;
      & > :global(:first-child)::before {
        font-family: Georgia, 'Times New Roman', serif;
        content: '\201C';
        line-height: 0;
        color: var(--sl-color-gray-2);
        opacity: 0.5;
        margin-inline-end: 0.15em;
        pointer-events: none;
        user-select: none;
      }
      & > :global(:last-child)::after {
        font-family: Georgia, 'Times New Roman', serif;
        content: '\201D';
        line-height: 0;
        color: var(--sl-color-gray-2);
        opacity: 0.5;
        margin-inline-start: 0.15em;
        pointer-events: none;
        user-select: none;
      }
      & > :global(* + *) {
        margin-top: 0.75em;
      }
    } 
    & footer {
      align-items: center;
      gap: 0.5rem;
      text-align: left;
      & img {
        outline: 1px solid var(--sl-color-accent-low);
        outline-offset: -1px;
        border-radius: 99rem;
        width: 2.5rem;
        height: 2.5rem;
        object-fit: cover;
      }
      & .cite {
        flex-direction: column;
        & p {
          font-weight: 500;
          font-size: var(--sl-text-sm);
          color: var(--sl-color-gray-2);
          line-height: var(--sl-line-height-headings);
        }
        & a {
          font-size: var(--sl-text-xs);
          text-decoration: none;
          color: var(--sl-color-accent-high);
          &:hover {
            text-decoration: underline;
          }
        } 
      }
    }
  }
  [data-theme='light'] li blockquote {
    background: var(--sl-color-gray-7);
  }
</style>
