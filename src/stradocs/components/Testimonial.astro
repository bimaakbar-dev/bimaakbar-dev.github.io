---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  handle: string;
  name: string;
  role?: string;
  cite?: string;
}

const { name, handle, role, cite } = Astro.props;

const avatars = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/testimonials/*.jpg",
);
const avatarPath = `../../assets/images/testimonials/${handle}.jpg`;
const avatar = avatars[avatarPath];
if (!avatar) {
  throw new Error(
    `Avatar not found for @${handle}. Available: ${Object.keys(avatars).join(", ")}`
  );
}
const src = (await avatar()).default;
---

<li class="testimonial not-content">
  <blockquote cite={cite}>
    <slot />
  </blockquote>
  <div class="attribution">
    <Image class="avatar" width="40" height="40" {src} alt={name} />
    <div class="meta">
      <span class="name">{name}</span>
      {role && <span class="role">{role}</span>}
    </div>
  </div>
</li>

<style>
  .testimonial {
    list-style: none;
    padding: 0;
    margin-block: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  blockquote {
    margin: 0;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    border-bottom-left-radius: 0;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    font-size: var(--sl-text-body-sm);
    line-height: var(--sl-line-height);

    & > :global(* + *) {
      margin-top: 0.5em;
    }
  }

  .attribution {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding-inline-start: 0.25rem;
  }

  .avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 99rem;
    object-fit: cover;
    flex-shrink: 0;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .name {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
    line-height: 1.3;
  }

  .role {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    line-height: 1.3;
  }
</style>