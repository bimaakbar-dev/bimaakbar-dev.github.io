---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import { navSections } from '~/config/navigation';

const pathname = Astro.url.pathname;
const isBlogPost = pathname.startsWith('/blog/') 
  && pathname !== '/blog/' 
  && pathname !== '/blog';

const { sidebar } = Astro.locals.starlightRoute;

const active = navSections.find((s) =>
  s.href === '/' ? pathname === '/' : pathname.startsWith(s.href)
) ?? navSections[0];
---

{isBlogPost ? (
  <>
    {/* Desktop: Related Posts + CTA */}
    <div class="sg-blog-sidebar-desktop sl-hidden md:sl-block">
      <div class="sg-sidebar-inner">
        <div class="sg-placeholder-block">
          <div class="sg-placeholder-label">Related Posts</div>
          <div class="sg-placeholder-item" />
          <div class="sg-placeholder-item" />
          <div class="sg-placeholder-item" />
        </div>
        <div class="sg-placeholder-block">
          <div class="sg-placeholder-label">CTA Newsletter</div>
          <div class="sg-placeholder-cta" />
        </div>
      </div>
    </div>

    {/* Mobile: Nav links + MobileMenuFooter only */}
    <div class="sg-blog-sidebar-mobile md:sl-hidden">
      <div class="sg-nav-links">
        <p class="sg-nav-label">Navigation</p>
        {navSections.map((s) => (
          <a
            href={s.href}
            class:list={['sg-nav-item', { 'is-active': s.href === active.href }]}
          >
            {s.label}
          </a>
        ))}
      </div>
      <div class="sg-mobile-footer">
        <MobileMenuFooter />
      </div>
    </div>
  </>
) : (
  <>
    <SidebarPersister>
      <SidebarSublist sublist={sidebar} />
    </SidebarPersister>
    <div class="md:sl-hidden">
      <MobileMenuFooter />
    </div>
  </>
)}

<style>
  @layer starlight.core {
    .sg-blog-sidebar-desktop {
      height: 100%;
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    .sg-sidebar-inner {
      padding-inline: var(--sl-sidebar-pad-x);
      padding-block: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .sg-blog-sidebar-mobile {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .sg-nav-links {
      padding-inline: var(--sl-sidebar-pad-x);
      padding-block: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .sg-nav-label {
      font-size: var(--sl-text-xs);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--sl-color-gray-3);
      margin-bottom: 0.5rem;
    }

    .sg-nav-item {
      display: block;
      padding: 0.5rem 0.75rem;
      font-size: var(--sl-text-sm);
      font-weight: 500;
      color: var(--sl-color-gray-2);
      text-decoration: none;
      border-radius: 0.375rem;
      transition: background 0.15s, color 0.15s;
    }

    .sg-nav-item:hover {
      background: var(--sl-color-gray-5);
      color: var(--sl-color-white);
    }

    .sg-nav-item.is-active {
      color: var(--sl-color-accent-high);
      font-weight: 600;
    }

    .sg-mobile-footer {
      padding-inline: var(--sl-sidebar-pad-x);
      padding-block: 1rem;
      border-top: 0.5px solid var(--sl-color-hairline);
    }

    .sg-placeholder-block {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .sg-placeholder-label {
      font-size: var(--sl-text-xs);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--sl-color-gray-3);
    }

    .sg-placeholder-item {
      height: 0.75rem;
      border-radius: 0.25rem;
      background: var(--sl-color-gray-5);
      width: 100%;
      opacity: 0.5;
    }

    .sg-placeholder-cta {
      height: 2.5rem;
      border-radius: 0.5rem;
      background: var(--sl-color-gray-5);
      opacity: 0.5;
    }
  }
</style>