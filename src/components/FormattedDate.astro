---
interface Props {
  date: Date;
  class?: string;
}

const { date, class: className } = Astro.props;
const { lang } = Astro.locals.starlightRoute || {};

const locale = lang || "en";
---

<time class={className} datetime={date.toISOString()}>
  {
    date.toLocaleDateString(locale, {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  }
</time>
