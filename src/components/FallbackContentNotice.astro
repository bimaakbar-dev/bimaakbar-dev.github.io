---
import Default from '@astrojs/starlight/components/FallbackContentNotice.astro'
import { Icon } from '@astrojs/starlight/components';

const { entry } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;

const isBlogIndex = pathname === '/blog/' || pathname === '/blog' || 
                    pathname === '/id/blog/' || pathname === '/id/blog';
const isBlogPost = entry.id?.startsWith('blog/') || entry.id?.startsWith('id/blog/');
---

{ isBlogIndex ? (
    <p class="sl-flex custom-draft-content-notice">
        <Icon name="warning" size="1.5em" color="var(--sl-color-orange-high)" />
        <span>{Astro.locals.t('i18n.untranslatedContent')}</span>
    </p>
) : isBlogPost ? (
    <p class="sl-flex custom-draft-content-notice">
        <Icon name="warning" size="1.5em" color="var(--sl-color-orange-high)" />
        <span>{Astro.locals.t('i18n.untranslatedContent')}</span>
    </p>
) : (
    <Default />
)}

<style>
    .custom-draft-content-notice {
        border: 1px solid var(--sl-color-orange);
        padding: 0.75em 1em;
        background-color: var(--sl-color-orange-low);
        color: var(--sl-color-orange-high);
        max-width: 45rem;
        width: 100%;
        align-items: center;
        gap: 0.75em;
        font-size: var(--sl-text-body-sm);
        line-height: var(--sl-line-height-headings);
        text-align: start;
        border-radius: 0.5rem;
        margin: 0 auto
    }
</style>