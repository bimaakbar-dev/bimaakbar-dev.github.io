---
// FallbackContentNotice.astro
import { Icon } from '@astrojs/starlight/components';

const { isBlog } = Astro.locals.starlightRoute;
---

{
  isBlog ? (
    <p class="sl-flex custom-content-notice">
      <Icon name="warning" size="1.5em" color="var(--sl-color-orange-high)" />
      <span>{Astro.locals.t('i18n.untranslatedContent')}</span>
    </p>
  ) : (
    <p class="sl-flex">
      <Icon name="warning" size="1.5em" color="var(--sl-color-orange-high)" class="items-start" />
      <span>{Astro.locals.t('i18n.untranslatedContent')}</span>
    </p>
  )
}

<style>
		p {
			border: 1px solid var(--sl-color-orange);
			padding: 0.75em 1em;
			background-color: var(--sl-color-orange-low);
			color: var(--sl-color-orange-high);
			width: max-content;
			max-width: 100%;
			align-items: center;
			gap: 0.75em;
			font-size: var(--sl-text-body-sm);
			line-height: var(--sl-line-height-headings);
			text-align: start;
      border-radius: 0.5rem;
		}

    p svg,
    .custom-content-notice svg {
      align-items: start;
      text-align: center;
      flex-shrink: 0;
    }
    .custom-content-notice {
      border: 1px solid var(--sl-color-orange);
      padding: 0.75em 1em;
      background-color: var(--sl-color-orange-low);
      color: var(--sl-color-orange-high);
      max-width: 45rem;
      width: 100%;
      align-items: center;
      gap: 0.75em;
      font-size: var(--sl-text-body-sm);
      line-height: var(--sl-line-height-headings);
      text-align: start;
      border-radius: 0.5rem;
      margin: 0 auto;
    }
</style>