---
// src/components/GlobalMobileMenu.astro
import { Icon } from "@astrojs/starlight/components";
import MobileMenuFooter from "~/components/overrides/MobileMenuFooter.astro";
import NavLinks from "./NavLinks.astro";
---

<details class="mobile-menu sl-block md:sl-hidden print:hidden">
  <summary aria-controls="mobile-menu-panel" class="menu-button">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="open-icon">
	  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5"></path>
	</svg>
    <Icon name="close" class="close-icon" />
    <span class="sr-only">{Astro.locals.t("menuButton.accessibleLabel")}</span>
  </summary>
  <div id="mobile-menu-panel" class="dropdown-panel">
    <NavLinks />
    <MobileMenuFooter />
  </div>
</details>

<style>
  details {
    &:not([open]) summary .close-icon {
      display: none;
    }
    &[open] summary .open-icon {
      display: none;
    }
    & summary {
      position: fixed;
      top: calc((var(--sl-nav-height) - var(--sl-menu-button-size)) / 2);
      inset-inline-end: var(--sl-nav-pad-x);
      z-index: var(--sl-z-index-navbar);
      width: var(--sl-menu-button-size);
      height: var(--sl-menu-button-size);
      padding: 0.25rem;
      border-radius: 0.5rem;
      background-color: transparent;
      color: var(--sl-color-white);
      box-shadow: none;
      cursor: pointer;
      align-items: center;
      justify-content: center;
      display: flex;
      flex-shrink: 0;
      &:has([open]) {
        color: var(--sl-color-white);
      }
      & svg {
        flex-shrink: 0;
        width: 1.333em;
        height: 1.333em;
      }
      &::marker,
      &::-webkit-details-marker {
        display: none;
      }
    }
    .dropdown-panel {
      position: fixed;
      top: calc(var(--sl-nav-height) - 1px);
      inset-inline: 0;
      width: 100%;
      max-width: calc(100dvw);
      padding-inline: 1rem;
      padding-block-start: 0.5rem;
      background: var(--sl-color-black);
      z-index: var(--sl-z-index-menu);
      box-shadow: var(--sl-shadow-sm);
      border-bottom: 1px solid var(--sl-color-gray-5);
      border-bottom-left-radius: 1rem;
      border-bottom-right-radius: 1rem;
    }
  }
</style>

<script is:inline>
  document.addEventListener('click', (e) => {
    const menu = document.querySelector('.mobile-menu');
    if (!(menu instanceof HTMLDetailsElement)) return;
    if (!menu.open) return;

    const target = e.target;
    if (!(target instanceof Node)) return;

    if (!menu.contains(target)) {
      menu.open = false;
    }
  });
</script>