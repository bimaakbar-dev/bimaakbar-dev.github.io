---
// src/components/GlobalMobileMenu.astro
import { Icon } from "@astrojs/starlight/components";
import MobileMenuFooter from "~/components/overrides/MobileMenuFooter.astro";
import NavLinks from "./NavLinks.astro";
---

<details class="mobile-menu md:sl-hidden print:hidden">
  <summary class="menu-button">
    <Icon name="bars" class="open-icon" size="1.333em" />
    <Icon name="close" class="close-icon" size="1.333em" />
    <span class="sr-only">{Astro.locals.t("menuButton.accessibleLabel")}</span>
  </summary>
  <div class="dropdown-panel bg-(--sl-color-bg-nav) isolate">
    <NavLinks />
    <MobileMenuFooter />
  </div>
</details>

<style>
  .mobile-menu {
    display: inline-flex;
    align-items: center;
  }

  .mobile-menu summary {
    position: relative;
    width: var(--sl-menu-button-size);
    height: var(--sl-menu-button-size);
    padding: 0.25rem;
    list-style: none;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    display: flex;
    flex-shrink: 0;
  }
  .mobile-menu summary .menu-button svg {
    flex-shrink: 0;
  }
  
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu:not([open]) .close-icon {
    display: none;
  }
  .mobile-menu[open] .open-icon {
    display: none;
  }

  .dropdown-panel {
    position: fixed;
    top: calc(var(--sl-nav-height));
    inset-inline: 0;
    width: 100%;
    max-width: calc(100dvw);
    padding-inline: 1rem;
    padding-block-start: 1rem;
    
    z-index: var(--sl-z-index-toc);
    box-shadow: var(--sl-shadow-lg);
    border-bottom: 1px solid var(--sl-color-gray-5);
    border-end-end-radius: 0.5rem;
    border-end-start-radius: 0.5rem;
  }

  .dropdown-panel :global(.nav-links) {
    flex-direction: column;
    gap: 0.75rem;
  }

  .dropdown-panel :global(.nav-link) {
    font-size: var(--sl-text-body);
    padding: 0.5rem 0;
    width: 100%;
  }

  @media (min-width: 50rem) {
    .mobile-menu {
      display: none;
    }
  }
</style>