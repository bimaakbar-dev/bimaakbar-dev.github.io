---
// src/components/MobileMenu.astro
import { Icon } from "@astrojs/starlight/components";
import MobileMenuFooter from "~/components/overrides/MobileMenuFooter.astro";
import NavLinks from "~/components/NavLinks.astro";
---

<details class="global-mobile-menu md:sl-hidden print:hidden">
  <summary class="menu-button">
    <Icon name="bars" class="open-icon" size="0.9em" />
    <Icon name="close" class="close-icon" size="0.9em" />
    <span class="sr-only">{Astro.locals.t("menuButton.accessibleLabel")}</span>
  </summary>
  <div class="dropdown-panel bg-(--sl-color-bg-nav)">
    <NavLinks />
    <MobileMenuFooter />
  </div>
</details>

<style>
  .mobile-preferences {
    justify-content: space-between;
    flex-wrap: wrap;
    border-top: 1px solid var(--sl-color-gray-6);
    column-gap: 1rem;
    padding: 0 !important;
    margin-top: 1rem;
  }
  .global-mobile-menu {
    display: inline-flex;
    align-items: center;
  }

  .global-mobile-menu summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: 0;
    background: transparent;
    padding: 0.25rem;
    border-radius: 0.5rem;
    color: var(--sl-color-white);
    font-size: 1.5rem;
    line-height: 1;
  }
  .global-mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .global-mobile-menu:not([open]) .close-icon {
    display: none;
  }
  .global-mobile-menu[open] .open-icon {
    display: none;
  }

  .dropdown-panel {
    position: fixed;
    top: calc(var(--sl-nav-height));
    inset-inline: 0;
    width: 100%;
    max-width: 100dvw;
    padding-inline: 1rem;
    padding-block-start: 1rem;
    padding-block-end: 0.5rem;
    z-index: var(--sl-z-index-menu);
    box-shadow: var(--sl-shadow-lg);
    border-bottom: 1px solid var(--sl-color-hairline);
    border-end-end-radius: 0.5rem;
    border-end-start-radius: 0.5rem;
  }

  .dropdown-panel :global(.nav-links) {
    flex-direction: column;
    gap: 0.75rem;
  }

  .dropdown-panel :global(.nav-link) {
    font-size: var(--sl-text-body);
    padding: 0.5rem 0;
    width: 100%;
  }

  @media (min-width: 50rem) {
    .global-mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const details = document.querySelector('.global-mobile-menu');
    if (!details) return;

    const handleClickOutside = (event) => {
      if (!details.open) return;
      if (details.contains(event.target)) return;
      details.open = false;
    };

    const handleKeyDown = (event) => {
      if (event.key === 'Escape' && details.open) {
        details.open = false;
        const summary = details.querySelector('summary');
        if (summary) summary.focus();
      }
    };

    const handleLinkClick = () => {
      details.open = false;
    };

    document.addEventListener('click', handleClickOutside);
    document.addEventListener('keydown', handleKeyDown);

    const links = details.querySelectorAll('.dropdown-panel a');
    links.forEach(link => {
      link.addEventListener('click', handleLinkClick);
    });
  });
</script>