---
// src/components/GlobalMobileMenu.astro
import { Icon } from "@astrojs/starlight/components";
import MobileMenuFooter from "~/components/overrides/MobileMenuFooter.astro";
import NavLinks from "./NavLinks.astro";
---

<details class="mobile-menu sl-flex md:sl-hidden print:hidden">
  <summary class="menu-button">
    <Icon name="bars" class="open-icon" size="1.333em" />
    <Icon name="close" class="close-icon" size="1.333em" />
    <span class="sr-only">{Astro.locals.t("menuButton.accessibleLabel")}</span>
  </summary>
  <div class="dropdown-panel bg-(--sl-color-bg-nav) isolate">
    <NavLinks />
    <MobileMenuFooter />
  </div>
</details>

<style>
  .mobile-menu summary {
    position: fixed;
    top: calc((var(--sl-nav-height) - var(--sl-menu-button-size)) / 2);
    inset-inline-end: var(--sl-nav-pad-x);
    z-index: var(--sl-z-index-navbar);
    width: var(--sl-menu-button-size);
    height: var(--sl-menu-button-size);
    padding: 0.5rem;
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: var(--sl-color-white);
    color: var(--sl-color-black);
    box-shadow: var(--sl-shadow-md);
    border-radius: 50%;
    line-height: 1;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu:not([open]) .close-icon {
    display: none;
  }
  .mobile-menu[open] .open-icon {
    display: none;
  }

  .mobile-menu[open] summary {
    background-color: var(--sl-color-gray-2);
    box-shadow: none;
  }

  /* Tema terang */
  :global([data-theme="light"]) .mobile-menu summary {
    background-color: var(--sl-color-black);
    color: var(--sl-color-white);
  }
  :global([data-theme="light"]) .mobile-menu[open] summary {
    background-color: var(--sl-color-gray-5);
  }

  .dropdown-panel {
    position: fixed;
    top: var(--sl-nav-height);
    inset-inline: 0;
    width: 100%;
    max-width: 100dvw;
    padding-inline: 1rem;
    padding-block-start: 1rem;
    z-index: var(--sl-z-index-toc);
    box-shadow: var(--sl-shadow-lg);
    border-bottom: 1px solid var(--sl-color-gray-5);
    border-end-end-radius: 0.5rem;
    border-end-start-radius: 0.5rem;
  }

  .dropdown-panel :global(.nav-links) {
    flex-direction: column;
    gap: 0.75rem;
  }

  .dropdown-panel :global(.nav-link) {
    font-size: var(--sl-text-body);
    padding: 0.5rem 0;
    width: 100%;
  }

  @media (min-width: 50rem) {
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener('click', function (e) {
    const menu = document.querySelector('.mobile-menu');
    if (!menu) return;
    if (menu.open && !menu.contains(e.target)) {
      menu.open = false;
    }
  });
</script>