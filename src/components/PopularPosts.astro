---
// src/components/PopularPosts.astro
import { getCollection } from "astro:content";

interface Props {
  limit?: number;
  excludeCurrent?: string;
  serverURL?: string;
}

const {
  limit = 5,
  excludeCurrent,
  serverURL = "https://bimaakbar-dev-comments.bimasaktiakbarr.workers.dev/api",
} = Astro.props;

const route = Astro.locals.starlightRoute as any;
const { blogPrefix, blogBasePath, id: routeId } = route;
const currentId = excludeCurrent || routeId;

const allEntries = await getCollection("docs", ({ id, data }) => {
  if (data.draft) return false;
  return id.startsWith(blogPrefix);
});

const posts = allEntries
  .filter((e) => e.id !== currentId)
  .map((e) => {
    const slug = e.id.slice(blogPrefix.length);
    const postPath = `${blogBasePath}/${slug}`;
    return {
      title: e.data.title,
      href: postPath,
      path: postPath,
      pubDate: e.data.pubDate ? +new Date(e.data.pubDate) : 0,
      views: 0,
    };
  });

const withViews = await Promise.all(
  posts.map(async (post) => {
    try {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 3000);

      const res = await fetch(
        `${serverURL}/article?path=${encodeURIComponent(post.path)}`,
        { signal: controller.signal },
      );
      clearTimeout(timeout);

      if (!res.ok) return post;
      const data = await res.json();
      const views = data?.data?.[0]?.time ?? 0;
      return { ...post, views };
    } catch {
      return post;
    }
  }),
);

const popularPosts = withViews
  .sort((a, b) => {
    if (b.views !== a.views) return b.views - a.views;
    return b.pubDate - a.pubDate;
  })
  .slice(0, limit);
---

{popularPosts.length > 0 && (
  <div class="popular-post sl-flex not-content">
    <h3 id="_popular-posts" set:html={Astro.locals.t("blog.PopularPostLabel")} />
    <nav aria-labelledby="_popular-posts">
      <ul>
        {popularPosts.map((post) => (
          <li>
            <a href={post.href}>{post.title}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
)}

<style>
  .popular-post {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border-block-end: 1px solid var(--sl-color-hairline);
  }

  .popular-post h3 {
    margin: 0;
    color: var(--sl-color-white);
    font-weight: 400;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-base);
  }

  .popular-post nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .popular-post nav ul li {
    margin-bottom: 0.5rem;
    padding: 0;
  }

  .popular-post nav ul li:last-child {
    margin-bottom: 0;
  }

  .popular-post nav ul li a {
    display: block;
    text-decoration: none;
    color: var(--sl-color-accent-high);
    font-size: var(--sl-text-base);
    line-height: 1.5;
    transition: color 0.15s ease;
  }

  .popular-post nav ul li a:hover {
    text-decoration: underline;
  }

  @media (min-width: 72rem) {
    .popular-post {
      padding: 1.75rem;
    }
  }
</style>
