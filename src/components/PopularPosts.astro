---
// src/components/PopularPosts.astro
import { getCollection } from "astro:content";

interface Props {
  limit?: number;
  excludeCurrent?: string;
}

const { 
  limit = 5, 
  excludeCurrent 
} = Astro.props;

const route = Astro.locals.starlightRoute as any;

const { 
  blogPrefix, 
  blogBasePath, 
  id: routeId 
} = route;

const currentId = excludeCurrent || routeId;

const allEntries = await getCollection("docs", ({ id, data }) => {
  if (data.draft) return false;
  return id.startsWith(blogPrefix);
});

const popularPosts = allEntries
  .filter((e) => e.id !== currentId)
  .filter((e) => !!e.data.pubDate)
  .sort((a, b) => {
    const da = a.data.pubDate ? +new Date(a.data.pubDate) : 0;
    const db = b.data.pubDate ? +new Date(b.data.pubDate) : 0;
    return db - da;
  })
  .slice(0, limit);
---

{popularPosts.length > 0 && (
  <div class="popular-post not-content">
    <h3 id="_popular-posts" set:html={Astro.locals.t("blog.PopularPostLabel")} />
    <nav aria-labelledby="_popular-posts">
      <ul>
        {popularPosts.map((post) => {
          const href = `${blogBasePath}/${post.id.slice(blogPrefix.length)}`;
          return (
            <li>
              <a href={href}>{post.data.title}</a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
)}

<style>
  .popular-post { 
    padding: 1.25rem;
    & h3 {
      color: var(--sl-color-white);
      font-weight: 400;
      font-family: var(--__sl-font-mono);
      font-size: var(--sl-text-lg);
    }
    & nav ul {
      list-style: none; 
      padding: 0; 
      margin: 0.5rem 0 0;
      & li {
        margin-bottom: 0.25rem;
        & a {
          display: block;
          padding: 0.3rem 0;
          text-decoration: none;
          color: var(--sl-color-accent-high);
          font-size: var(--sl-text-lg);
        }
      }
    }
  }
  @media (hover: hover) {
    a:hover { 
      text-decoration: underline; 
    }
  }
  @media (min-width: 72rem) { 
    .popular-post { 
      padding: 2rem; 
    }
  }
</style>