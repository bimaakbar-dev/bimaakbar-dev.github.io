---
// src/components/PopularPosts.astro
import { getCollection } from 'astro:content';

export interface Props {
  limit?: number;
  excludeCurrent?: string;
}

const { limit = 5, excludeCurrent } = Astro.props;

const route = Astro.locals.starlightRoute as any;

const blogPrefix = route.blogPrefix || 'blog/';
const blogBasePath = route.blogBasePath || '/blog';

const allEntries = await getCollection('docs', ({ id, data }) => {
  if (data.draft) return false;
  return id.startsWith(blogPrefix);
});

const popularPosts = allEntries
  .filter((entry): entry is typeof entry & { data: { pubDate: Date } } =>
    entry.data?.pubDate !== undefined
  )
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .filter((entry) => entry.id !== excludeCurrent)
  .slice(0, limit);
---

{
  popularPosts.length > 0 && (
    <div class="border-0 border-(--sl-color-gray-5) p-5 lg:border-b lg:p-8 xl:p-10">
      <h3
        class="text-(--sl-color-white) font-normal mb-4"
        style="font-family: var(--__sl-font-mono); font-size: var(--sl-text-body);"
      >
        {Astro.locals.t('blog.PopularPostLabel')}
      </h3>
      <ul class="popular-posts-list">
        {popularPosts.map((post) => {
          if (!post?.id) return null;

          const slug = post.id.slice(blogPrefix.length);
          const href = `${blogBasePath}/${slug}`;

          return (
            <li class="popular-posts-item">
              <a href={href} class="popular-posts-link">
                {post.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  )
}

<style>
  .popular-posts-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .popular-posts-item {
    margin-bottom: 0.25rem;
  }

  .popular-posts-link {
    display: block;
    padding: 0.3rem 0;
    text-decoration: none;
    color: var(--sl-color-accent-high);
    font-size: var(--sl-text-lg);
  }

  .popular-posts-link:hover {
    color: var(--sl-color-accent-high);
    text-decoration: underline;
  }
</style>