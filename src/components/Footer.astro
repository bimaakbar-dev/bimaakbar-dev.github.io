---
import { Icon } from '@astrojs/starlight/components';
import Default from '@astrojs/starlight/components/Footer.astro';

const { locale, entry } = Astro.locals.starlightRoute;

const currentLocale = locale || 'root';
const basePath = currentLocale === 'root' ? '/blog' : `/${currentLocale}/blog`;
const prefix = currentLocale === 'root' ? 'blog/' : `${currentLocale}/blog/`;

const pathname = Astro.url.pathname;
const isBlogIndex = pathname === basePath || pathname === `${basePath}/`;
const isBlogPost = entry.id?.startsWith(prefix);
const isBlogPage = isBlogIndex || isBlogPost;
---

{
  isBlogPage ? (
    <footer class="sl-flex">
      <a class="kudos sl-flex" href="https://starlight.astro.build">
        <Icon name="starlight" /> {Astro.locals.t('builtWithStarlight.label')}
      </a>
    </footer>
  ) : (
    <Default />
  )
}

<style>
  footer {
    flex-direction: column;
    gap: 1.5rem;
  }
  .kudos {
    align-items: center;
    gap: 0.5em;
    margin: 1.5rem auto;
    font-size: var(--sl-text-xs);
    text-decoration: none;
    color: var(--sl-color-gray-3);
  }
  .kudos:hover {
    color: var(--sl-color-white);
  }
  .kudos :global(svg) {
    color: var(--sl-color-orange);
  }
  :global(.sl-container footer) {
    border-top: 1px solid var(--sl-color-gray-5);
  }
</style>