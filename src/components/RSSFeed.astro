---
import { LinkButton } from '@astrojs/starlight/components';

const { locale } = Astro.locals.starlightRoute || {};
const currentLocale = locale || 'root';
const rssHref = currentLocale === 'root' ? '/rss.xml' : `/${currentLocale}/rss.xml`;
---

<div class="border-0 border-(--sl-color-gray-5) p-5 lg:border-b lg:p-8 xl:p-10">
    <h2 class="text-(--sl-color-white) font-normal" style="font-family: var(--__sl-font-mono); font-size: var(--sl-text-body);">
        {Astro.locals.t('rss.RssFeedLabel')}
    </h2>
    <p class="text-(--sl-color-gray-2) mb-6 mt-4" style="font-size: var(--sl-text-body)">
        {Astro.locals.t('rss.RssFeedDesc')}
    </p>
    <LinkButton href={rssHref} variant="secondary" icon="rss" iconPlacement="start">
        {Astro.locals.t('rss.RssFeedTitle')}
    </LinkButton>
</div>