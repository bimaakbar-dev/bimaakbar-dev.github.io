---
import { LinkButton } from '@astrojs/starlight/components';
---
<div class="border-0 border-(--sl-color-gray-5) p-5 lg:border-b lg:p-8 xl:p-10">
    <h2 class="text-(--sl-color-white)" style="font-family: var(--__sl-font-mono); font-size: var(--sl-text-h5);">
        {Astro.locals.t('rss.RssFeedLabel')}
    </h2>
    <p class="text-(--sl-color-gray-2) mb-6 mt-4" style="font-size: var(--sl-text-body)">
        {Astro.locals.t('rss.RssFeedDesc')}
    </p>
    <LinkButton href="/rss.xml" variant='secondary' icon='rss' iconPlacement="start">
        {Astro.locals.t('rss.RssFeedTitle')}
    </LinkButton>
</div>