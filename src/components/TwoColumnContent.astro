---
import Default from '@astrojs/starlight/components/TwoColumnContent.astro';

const pathname = Astro.url.pathname;
const isBlogPost = pathname.startsWith('/blog/') 
  && pathname !== '/blog/' 
  && pathname !== '/blog';
---

{isBlogPost ? (
  <div class="sg-blog-post">
    <aside class="sg-sidebar print:hidden">
      <div class="sg-sidebar-inner">
        <div class="sg-placeholder-block">
          <div class="sg-placeholder-label">Related Posts</div>
          <div class="sg-placeholder-item" />
          <div class="sg-placeholder-item" />
          <div class="sg-placeholder-item" />
        </div>
        <div class="sg-placeholder-block">
          <div class="sg-placeholder-label">CTA</div>
          <div class="sg-placeholder-cta" />
        </div>
      </div>
    </aside>

    <Default>
      <slot />
      <slot name="right-sidebar" slot="right-sidebar" />
    </Default>

    <aside class="sg-pagebar print:hidden" aria-hidden="true" />
  </div>
) : (
  <Default>
    <slot />
    <slot name="right-sidebar" slot="right-sidebar" />
  </Default>
)}