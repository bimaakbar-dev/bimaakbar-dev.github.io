---
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import { navSections } from '~/config/navigation';

const pathname = Astro.url.pathname;

const active = navSections.find((s) =>
  s.href === '/' ? pathname === '/' : pathname.startsWith(s.href)
) ?? navSections[0];
---

<div class="sl-flex print:hidden sg-header">
  <Default />

  <label class="nav-select-wrapper">
    <span class="sr-only">Pilih seksi</span>
    <svg class="nav-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M2 4h10M2 7h7M2 10h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <select class="nav-select" autocomplete="off">
      {navSections.map((s) => (
        <option value={s.href} selected={s.href === active.href}>
          {s.label}
        </option>
      ))}
    </select>
    <svg class="nav-caret" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </label>
</div>

<style>
  @layer starlight.core {
    .sg-header {
      align-items: center;
      gap: 0.25rem;
    }

    .nav-select-wrapper {
      --icon-size: 0.875rem;
      --caret-size: 1.25rem;
      --pad: 0.5rem;
      position: relative;
      display: flex;
      align-items: center;
      color: var(--sl-color-gray-2);
      cursor: pointer;
    }

    .nav-select-wrapper:hover {
      color: var(--sl-color-white);
    }

    .nav-icon,
    .nav-caret {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
    }

    .nav-icon {
      inset-inline-start: 0;
      font-size: var(--icon-size);
    }

    .nav-caret {
      inset-inline-end: 0;
      font-size: var(--caret-size);
    }

    .nav-select {
      border: 0;
      padding-block: 0.625rem;
      padding-inline: calc(var(--icon-size) + var(--pad) + 0.25rem)
        calc(var(--caret-size) + var(--pad) + 0.25rem);
      margin-inline: calc(var(--pad) * -1);
      background-color: transparent;
      color: inherit;
      cursor: pointer;
      appearance: none;
      font-size: var(--sl-text-sm);
    }

    option {
      background-color: var(--sl-color-bg-nav);
      color: var(--sl-color-gray-1);
    }
  }
</style>

<script>
  const select = document.querySelector<HTMLSelectElement>('.nav-select');
  select?.addEventListener('change', (e) => {
    if (e.currentTarget instanceof HTMLSelectElement) {
      window.location.pathname = e.currentTarget.value;
    }
  });
</script>