---
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import { Icon } from '@astrojs/starlight/components';
import { navSections } from '~/config/navigation';

const pathname = Astro.url.pathname;

const active = navSections.find((s) =>
  s.href === '/' ? pathname === '/' : pathname.startsWith(s.href)
) ?? navSections[0];
---

<div class="sl-flex print:hidden sg-header">
  <Default />

  <label class="nav-select-wrapper">
    <span class="sr-only">Pilih seksi</span>
    <select class="nav-select" autocomplete="off">
      {navSections.map((s) => (
        <option value={s.href} selected={s.href === active.href}>
          {s.label}
        </option>
      ))}
    </select>
    <Icon name="down-caret" class="nav-caret" aria-hidden="true" />
  </label>
</div>

<style>
  @layer starlight.core {
    .sg-header {
      align-items: baseline;
      gap: 0.25rem;
    }

    .nav-select-wrapper {
      position: relative;
      display: flex;
      align-items: baseline;
      color: var(--sl-color-gray-2);
      transition: color 0.2s;
    }

    .nav-select-wrapper:hover {
      color: var(--sl-color-white);
    }

    .nav-select {
      appearance: none;
      background: transparent;
      border: 0.5px solid var(--sl-color-hairline);
      border-radius: 0.5rem;
      color: inherit;
      cursor: pointer;
      font-size: var(--sl-text-sm);
      font-weight: 500;
      padding: 0.25rem 2rem 0.25rem 0.75rem;
      vertical-align: baseline;
      transition: border-color 0.2s;
    }

    .nav-select:hover,
    .nav-select:focus-visible {
      border-color: var(--sl-color-gray-3);
      outline: none;
    }

    option {
      background-color: var(--sl-color-bg-nav);
      color: var(--sl-color-gray-1);
    }

    .nav-caret {
      position: absolute;
      inset-inline-end: 0.5rem;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
      font-size: 1rem;
    }
  }
</style>

<script>
  const select = document.querySelector<HTMLSelectElement>('.nav-select');
  select?.addEventListener('change', (e) => {
    if (e.currentTarget instanceof HTMLSelectElement) {
      window.location.pathname = e.currentTarget.value;
    }
  });
</script>