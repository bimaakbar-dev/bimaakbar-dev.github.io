---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';

const pathname = Astro.url.pathname;
const isBlogPost = pathname.startsWith('/blog/') 
  && pathname !== '/blog/' 
  && pathname !== '/blog';
---

<Default>
  <slot />
</Default>

{isBlogPost && (
  <div class="sg-mobile-related md:sl-hidden">
    <div class="sg-sidebar-inner">
      <div class="sg-placeholder-block">
        <div class="sg-placeholder-label">Related Posts</div>
        <div class="sg-placeholder-item" />
        <div class="sg-placeholder-item" />
        <div class="sg-placeholder-item" />
      </div>
      <div class="sg-placeholder-block">
        <div class="sg-placeholder-label">CTA Newsletter</div>
        <div class="sg-placeholder-cta" />
      </div>
    </div>
  </div>
)}

<style>
  @layer starlight.core {
    .sg-mobile-related {
      border-top: 0.5px solid var(--sl-color-hairline);
      margin-top: 2rem;
    }

    .sg-sidebar-inner {
      padding-inline: var(--sl-content-pad-x);
      padding-block: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .sg-placeholder-block {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .sg-placeholder-label {
      font-size: var(--sl-text-xs);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--sl-color-gray-3);
    }

    .sg-placeholder-item {
      height: 0.75rem;
      border-radius: 0.25rem;
      background: var(--sl-color-gray-5);
      width: 100%;
      opacity: 0.5;
    }

    .sg-placeholder-cta {
      height: 2.5rem;
      border-radius: 0.5rem;
      background: var(--sl-color-gray-5);
      opacity: 0.5;
    }
  }
</style>