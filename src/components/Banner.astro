---
import Default from '@astrojs/starlight/components/Banner.astro';
---
<Default>
	<span aria-hidden="true" class="star-container">
  	<span class="star" style="left:1%;top:30%; background-color: color-mix(in srgb, var(--sl-color-white) 70%, transparent);"></span>
  	<span class="star" style="left:3%;top:70%; background-color: color-mix(in srgb, var(--sl-color-white) 50%, transparent);"></span>
  	<span class="star" style="left:5%;top:22%; background-color: color-mix(in srgb, var(--sl-color-white) 60%, transparent);"></span>
  	<span class="star" style="left:7%;top:58%; background-color: color-mix(in srgb, var(--sl-color-white) 45%, transparent);"></span>
  	<span class="star" style="left:9%;top:84%; background-color: color-mix(in srgb, var(--sl-color-white) 55%, transparent);"></span>
  	<span class="star" style="left:12%;top:36%; background-color: color-mix(in srgb, var(--sl-color-white) 50%, transparent);"></span>
  	<span class="star" style="left:15%;top:18%; background-color: color-mix(in srgb, var(--sl-color-white) 60%, transparent);"></span>
  	<span class="star" style="left:18%;top:64%; background-color: color-mix(in srgb, var(--sl-color-white) 40%, transparent);"></span>
  	<span class="star" style="left:21%;top:80%; background-color: color-mix(in srgb, var(--sl-color-white) 50%, transparent);"></span>
  	<span class="star" style="left:24%;top:28%; background-color: color-mix(in srgb, var(--sl-color-white) 55%, transparent);"></span>
  	<span class="star" style="left:76%;top:24%; background-color: color-mix(in srgb, var(--sl-color-white) 55%, transparent);"></span>
  	<span class="star" style="left:79%;top:76%; background-color: color-mix(in srgb, var(--sl-color-white) 50%, transparent);"></span>
  	<span class="star" style="left:82%;top:40%; background-color: color-mix(in srgb, var(--sl-color-white) 60%, transparent);"></span>
  	<span class="star" style="left:85%;top:60%; background-color: color-mix(in srgb, var(--sl-color-white) 45%, transparent);"></span>
  	<span class="star" style="left:88%;top:18%; background-color: color-mix(in srgb, var(--sl-color-white) 50%, transparent);"></span>
  	<span class="star" style="left:91%;top:82%; background-color: color-mix(in srgb, var(--sl-color-white) 60%, transparent);"></span>
  	<span class="star" style="left:94%;top:32%; background-color: color-mix(in srgb, var(--sl-color-white) 55%, transparent);"></span>
  	<span class="star" style="left:96%;top:66%; background-color: color-mix(in srgb, var(--sl-color-white) 45%, transparent);"></span>
  	<span class="star" style="left:98%;top:24%; background-color: color-mix(in srgb, var(--sl-color-white) 50%, transparent);"></span>
  	<span class="star" style="left:99%;top:78%; background-color: color-mix(in srgb, var(--sl-color-white) 60%, transparent);"></span>
	</span>
	<slot />
</Default>

<style>
	.star-container {
    	pointer-events: none;
    	position: absolute;
    	inset: 0;
	}

	.star {
    	position: absolute;
    	width: 1px;
    	height: 1px;
    	border-radius: 9999px;
	}
</style>