---
import { Icon } from '@astrojs/starlight/components';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const label = Astro.locals.t('search.label');
---

<button
  type="button"
  data-search-toggle
  class:list={['search-toggle', className]}
  aria-label={label}
>
  <Icon name="magnifier" />
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('button[data-search-toggle]');
  if (btn) {
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('starlight:open-search'));
    });
  }
</script>

<style>
  .search-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--sl-color-gray-1);
    cursor: pointer;
    font-size: var(--sl-text-xl);
    transition: color 0.15s ease;
  }

  .search-toggle:hover {
    color: var(--sl-color-white);
  }

  .search-toggle:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
    border-radius: 0.375rem;
  }

  @media (min-width: 50rem) {
    .search-toggle {
      display: none;
    }
  }
</style>