---
// src/components/NavLinks.astro
import NavLink from '~/components/HeaderLink.astro';

const { locale, blogBasePath } = Astro.locals.starlightRoute;

const currentLocale = locale || 'root';
const base = currentLocale === 'root' ? '' : `/${currentLocale}`;
const blogLink = blogBasePath || `${base}/blog`;
---

<nav class="nav-links">
  <NavLink href={`${base}/docs/getting-started/introduction`} matchPrefix>
    Docs
  </NavLink>
  <NavLink href={blogLink as string} matchPrefix>
    Blog
  </NavLink>
</nav>

<style>
  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }
</style>