---
// src/components/NavLinks.astro
import NavLink from '~/components/HeaderLink.astro';

const { locale } = Astro.locals.starlightRoute;

const currentLocale = locale || 'root';
const base = currentLocale === 'root' ? '' : `/${currentLocale}`;
---

<nav class="nav-links">
  <NavLink href={`${base}/`} matchPrefix>Docs</NavLink>
  <NavLink href={`${base}/blog`} matchPrefix>Blog</NavLink>
</nav>

<style>
  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  @media (max-width: 50rem) {
    .nav-links {
      display: none;
    }
  }
</style>