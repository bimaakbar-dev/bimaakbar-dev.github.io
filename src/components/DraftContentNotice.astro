---
// DraftContentNotice.astro
import Default from '@astrojs/starlight/components/DraftContentNotice.astro';
import { Icon } from '@astrojs/starlight/components';

const { locale, entry } = Astro.locals.starlightRoute;
const currentLocale = locale || 'root';
const basePath = currentLocale === 'root' ? '/blog' : `/${currentLocale}/blog`;
const prefix = currentLocale === 'root' ? 'blog/' : `${currentLocale}/blog/`;

const pathname = Astro.url.pathname;
const isBlogIndex = pathname === basePath || pathname === `${basePath}/`;
const isBlogPost = entry.id?.startsWith(prefix);
const isBlogPage = isBlogIndex || isBlogPost;
---

{
  isBlogPage ? (
    <p class="sl-flex custom-draft-content-notice">
      <Icon name="warning" size="1.5em" color="var(--sl-color-orange-high)" />
      <span>{Astro.locals.t('page.draft')}</span>
    </p>
  ) : (
    <Default />
  )
}

<style>
  .custom-draft-content-notice {
    border: 1px solid var(--sl-color-orange);
    padding: 0.75em 1em;
    background-color: var(--sl-color-orange-low);
    color: var(--sl-color-orange-high);
    max-width: 45rem;
    width: 100%;
    align-items: center;
    gap: 0.75em;
    font-size: var(--sl-text-body-sm);
    line-height: var(--sl-line-height-headings);
    text-align: start;
    border-radius: 0.5rem;
    margin: 0 auto;
  }
</style>