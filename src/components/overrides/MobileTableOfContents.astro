---
import { Icon } from '@astrojs/starlight/components';
import TableOfContentsList from './components-internals/TableOfContents/TableOfContentsList.astro';

const { toc } = Astro.locals.starlightRoute;
---

{
	toc && (
		<mobile-starlight-toc data-min-h={toc.minHeadingLevel} data-max-h={toc.maxHeadingLevel}>
			<nav aria-labelledby="starlight__on-this-page--mobile">
				<details id="starlight__mobile-toc">
					<summary id="starlight__on-this-page--mobile" class="sl-flex">
						<span class="toggle sl-flex items-center">
							<span class="progress-circle-wrapper" role="progressbar" aria-label="Reading progress" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
								<svg class="progress-circle" viewBox="0 0 24 24" aria-hidden="true">
									<circle
										cx="12"
										cy="12"
										r="10"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										class="progress-track"
									/>
									<circle
										class="progress-fill"
										cx="12"
										cy="12"
										r="10"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-dasharray="0 62.83"
										transform="rotate(-90 12 12)"
									/>
								</svg>
							</span>
							<span class="label-wrap">
								<span class="label-current display-current"></span>
								<span class="label-static">{Astro.locals.t('tableOfContents.onThisPage')}</span>
							</span>
							<Icon name={'right-caret'} class="caret" size="1rem" />
						</span>
					</summary>
					<div class="dropdown">
						<TableOfContentsList toc={toc.items} isMobile />
					</div>
				</details>
			</nav>
		</mobile-starlight-toc>
	)
}

<style>
  nav {
    position: fixed;
    z-index: var(--sl-z-index-toc);
    top: calc(var(--sl-nav-height) - 1px);
    inset-inline: 0;
    border-top: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-bg-nav);
  }
  @media (min-width: 50rem) {
    nav {
      inset-inline-start: var(--sl-content-inline-start, 0);
    }
  }

  summary {
    gap: 0.5rem;
    align-items: center;
    height: var(--sl-mobile-toc-height);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    padding: 0.5rem 1rem;
    font-size: var(--sl-text-xs);
    outline-offset: var(--sl-outline-offset-inside);
    cursor: pointer;
  }
  summary::marker,
  summary::-webkit-details-marker {
    display: none;
  }

  .toggle {
    flex-shrink: 0;
    gap: 0.5rem;
    align-items: center;
    border: none;
    border-radius: 0.5rem;
    padding-block: 0.375rem;
    padding-inline: 0;
    line-height: 1;
    width: 100%;
    height: 1.25em;
    background-color: transparent;
    user-select: none;
    cursor: pointer;
    color: var(--sl-color-text);
    transition: color 0.2s ease;
  }
  details[open] .toggle {
    color: var(--sl-color-white);
    border-color: transparent;
    background-color: transparent;
  }
  .toggle:hover {
    color: var(--sl-color-white);
    border-color: transparent;
  }
  .progress-circle-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.25em;
    height: 1.25em;
  }
  .progress-circle {
    width: 100%;
    height: 100%;
    display: block;
  }
  .progress-track {
    opacity: 0.25;
  }
  .progress-fill {
    transition: stroke-dasharray 0.15s ease-out;
    color: var(--sl-color-accent-high);
  }
  .label-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 1.25em;
    overflow: hidden;
  }
  .label-current,
  .label-static {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .label-current {
    transform: translateY(0);
    opacity: 1;
  }
  .label-static {
    transform: translateY(100%);
    opacity: 0;
  }
  details[open] .label-current {
    transform: translateY(-100%);
    opacity: 0;
  }
  details[open] .label-static {
    transform: translateY(0);
    opacity: 1;
  }
  .label-current:empty {
    opacity: 0;
    transform: translateY(-100%);
  }
  .label-current:empty ~ .label-static {
    opacity: 1;
    transform: translateY(0);
  }
  [dir='rtl'] .caret {
    transform: rotateZ(180deg);
  }
  details[open] .caret {
    transform: rotateZ(90deg);
  }
  .caret {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .dropdown {
    --border-top: 1px;
    
    margin-top: calc(-1 * var(--border-top));
    border-block: var(--border-top) solid var(--sl-color-hairline-shade);
    max-height: calc(85vh - var(--sl-nav-height) - var(--sl-mobile-toc-height));
    overflow-y: auto;
    background-color: var(--sl-color-bg-nav);
    box-shadow: var(--sl-shadow-md);
    overscroll-behavior: contain;
  }
</style>

<script>
  import { StarlightTOC } from './components-internals/TableOfContents/starlight-toc';

  class MobileStarlightTOC extends StarlightTOC {
    override set current(link: HTMLAnchorElement) {
      super.current = link;
      const display = this.querySelector('.display-current') as HTMLSpanElement;
      if (display) display.textContent = link.textContent;
    }

    constructor() {
      super();
      const details = this.querySelector('details');
      if (!details) return;

      // Progress circle — pakai circumference lingkaran r=10: 2π×10 ≈ 62.83
      const circumference = 62.83;
      const progressFill = this.querySelector('.progress-fill') as SVGCircleElement | null;
      const progressWrapper = this.querySelector('.progress-circle-wrapper') as HTMLElement | null;

      const updateProgress = () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
        const drawn = progress * circumference;

        if (progressFill) {
          progressFill.style.strokeDasharray = `${drawn} ${circumference - drawn}`;
        }
        if (progressWrapper) {
          progressWrapper.setAttribute('aria-valuenow', String(Math.round(progress * 100)));
        }
      };

      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
      updateProgress();

      const closeToC = () => { details.open = false; };

      details.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', closeToC);
      });
      window.addEventListener('click', (e) => {
        if (!details.contains(e.target as Node)) closeToC();
      });
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && details.open) {
          const hasFocus = details.contains(document.activeElement);
          closeToC();
          if (hasFocus) {
            const summary = details.querySelector('summary');
            if (summary) summary.focus();
          }
        }
      });
    }
  }

  customElements.define('mobile-starlight-toc', MobileStarlightTOC);
</script>