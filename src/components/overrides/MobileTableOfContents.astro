---
import { Icon } from '@astrojs/starlight/components';
import TableOfContentsList from './components-internals/TableOfContents/TableOfContentsList.astro';

const { toc } = Astro.locals.starlightRoute;
---

{
	toc && (
		<mobile-starlight-toc data-min-h={toc.minHeadingLevel} data-max-h={toc.maxHeadingLevel}>
			<nav aria-labelledby="starlight__on-this-page--mobile">
				<details id="starlight__mobile-toc">
					<summary id="starlight__on-this-page--mobile" class="sl-flex">
						<span class="toggle">
							<svg class="progress-circle" viewBox="0 0 18 18" focusable="false" aria-hidden="true">
								<circle
									cx="9"
									cy="9"
									r="7.5"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									class="progress-bg"
								/>
								<circle
									class="progress-fill"
									cx="9"
									cy="9"
									r="7.5"
									fill="none"
									stroke="var(--sl-color-accent-high)"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-dasharray="47.12388980384689"
									stroke-dashoffset="47.12388980384689"
									transform="rotate(-90 9 9)"
								/>
							</svg>
							{Astro.locals.t('tableOfContents.onThisPage')}
							<Icon name={'right-caret'} class="caret" size="1rem" />
						</span>
						<span class="display-current" />
					</summary>
					<div class="dropdown">
						<TableOfContentsList toc={toc.items} isMobile />
					</div>
				</details>
			</nav>
		</mobile-starlight-toc>
	)
}

<style>
  nav {
    position: fixed;
	z-index: var(--sl-z-index-menu);
	top: calc(var(--sl-nav-height) - 1px);
	inset-inline: 0;
	border-top: 1px solid var(--sl-color-hairline-light);
	background-color: rgb(from var(--sl-color-bg-nav) r g b / 100%);
	-webkit-backdrop-filter: blur(16px);
  	backdrop-filter: blur(16px);
  }
  @media (min-width: 50rem) {
	nav {
	  inset-inline-start: var(--sl-content-inline-start, 0);
	}
  }
  summary {
	gap: 0.5em;
	align-items: center;
	height: var(--sl-mobile-toc-height);
	border-bottom: 1px solid var(--sl-color-hairline-shade);
	padding: 0.5rem 1rem;
	font-size: var(--sl-text-xs);
    line-height: 1.25;
	outline-offset: var(--sl-outline-offset-inside);
	box-shadow: none;
  }
  summary::marker,
  summary::-webkit-details-marker {
	display: none;
  }
  .toggle {
    display: inline-flex;
	gap: 0.5em;
	align-items: center;
	line-height: 1.25;
	user-select: none;
	cursor: pointer;
	vertical-align: baseline;
	height: 100%;
	flex-shrink: 0;
  }
  .progress-circle {
	display: block;
	width: 1.25em;
    height: 1.25em;
	flex-shrink: 0;
	vertical-align: middle;
	/*font-size: inherit;*/
  }
  .progress-bg {
	color: rgb(from var(--sl-color-hairline-light) r g b / 100%)
  }
  .progress-fill {
	transition: stroke-dashoffset 0.15s ease-out;
  }
  details[open] .toggle {
	color: var(--sl-color-text-accent);
  }
  details[open] .progress-bg {
	color: rgb(from var(--sl-color-accent-high) r g b / 20%)
  }
  details .toggle:hover {
	color: var(--sl-color-white);
  }
  [dir='rtl'] .caret {
	transform: rotateZ(180deg);
  }
  details[open] .caret {
	transform: rotateZ(90deg);
  }
  .display-current {
	white-space: nowrap;
	text-overflow: ellipsis;
	overflow: hidden;
	color: var(--sl-color-text);
  }
  .dropdown {
	--border-top: 1px;
	margin-top: calc(-1 * var(--border-top));
	border-block: var(--border-top) solid var(--sl-color-hairline-shade);
	max-height: calc(85vh - var(--sl-nav-height) - var(--sl-mobile-toc-height));
	overflow-y: auto;
	background-color: rgb(from var(--sl-color-bg-nav) r g b / 100%);
	box-shadow: var(--sl-shadow-md);
	overscroll-behavior: contain;
	z-index: var(--sl-z-index-toc);
	padding-block: 0.5rem;
	padding-inline: 0.25rem;
	scrollbar-gutter: stable;
  }
</style>

<script>
	import { StarlightTOC } from './components-internals/TableOfContents/starlight-toc';

	class MobileStarlightTOC extends StarlightTOC {
		override set current(link: HTMLAnchorElement) {
			super.current = link;
			const display = this.querySelector('.display-current') as HTMLSpanElement;
			if (display) display.textContent = link.textContent;
		}

		constructor() {
			super();
			const details = this.querySelector('details');
			if (!details) return;

			const circumference = 47.12388980384689;

			const updateProgress = () => {
				const scrollTop = window.scrollY;
				const docHeight = document.documentElement.scrollHeight - window.innerHeight;
				const progress = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
				const offset = circumference * (1 - progress);
				const circle = this.querySelector('.progress-fill') as SVGCircleElement | null;
				if (circle) circle.style.strokeDashoffset = offset.toString();
			};

			window.addEventListener('scroll', updateProgress, { passive: true });
			window.addEventListener('resize', updateProgress);
			updateProgress();

			const closeToC = () => {
				details.open = false;
			};
			details.querySelectorAll('a').forEach((a) => {
				a.addEventListener('click', closeToC);
			});
			window.addEventListener('click', (e) => {
				if (!details.contains(e.target as Node)) closeToC();
			});
			window.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && details.open) {
					const hasFocus = details.contains(document.activeElement);
					closeToC();
					if (hasFocus) {
						const summary = details.querySelector('summary');
						if (summary) summary.focus();
					}
				}
			});
		}
	}

	customElements.define('mobile-starlight-toc', MobileStarlightTOC);
</script>