---
import Default from "@astrojs/starlight/components/Head.astro";
import { Font } from "astro:assets";
import { SEO } from '~/constants';

const { 
  entry, 
  siteDescription, 
  isBlog,
  isBlogPost,
  rssUrl,
  siteTitle,
} = Astro.locals.starlightRoute;

const data = (entry?.data as any) || {};

let ogImage = "/og.jpg?v=1";

if (data.heroImage) {
  if (typeof data.heroImage === "string") ogImage = data.heroImage;
  else if (data.heroImage.src) ogImage = data.heroImage.src;
  else if (data.heroImage.file?.src) ogImage = data.heroImage.file.src;
}

const hasManualOg = data.head?.some(
  (h: any) => h.attrs?.property === "og:image",
);

const absolutOg = (() => {
  try {
    return new URL(ogImage, Astro.site || Astro.url).href;
  } catch {
    return ogImage;
  }
})();

const ogImageAlt = data.title || siteDescription;
---

<Font cssVariable="--font-montserrat" preload />
<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-firaCode" preload />

<Default>
	<slot />
</Default>

{!hasManualOg && entry && (
	<>
      <meta property="og:image" content={absolutOg} />
      <meta property="og:image:alt" content={ogImageAlt} />
    </>
)}

<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="apple-mobile-web-app-title" content={siteTitle} />

<link rel="icon" type="image/png" href="/images/favicons/favicon-96x96.png" sizes="96x96" />
<link rel="apple-touch-icon" sizes="180x180" href="/images/favicons/apple-touch-icon.png" />
<link rel="manifest" href="/images/favicons/site.webmanifest" />

<meta name="google-site-verification" content={SEO.verification.google} />
<meta name="msvalidate.01" content={SEO.verification.bing} />
<meta name="yandex-verification" content={SEO.verification.yandex} />
<meta name="google-adsense-account" content={SEO.ads.google} />

<script async src={`https://www.googletagmanager.com/gtag/js?id=${SEO.analytics.google}`}></script>
<script is:inline define:vars={{ gaId: SEO.analytics.google }}>
  // @ts-ignore
  window.dataLayer = window.dataLayer || [];
  // @ts-ignore
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  // @ts-ignore
  gtag('config', gaId);
</script>

<script
  async
  src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SEO.ads.google}`}
  crossorigin="anonymous"
></script>
{ 
	isBlog && (
		<link
			rel="alternate"
			type="application/rss+xml"
			title="RSS Feed"
			href={rssUrl as string}
		/>
	)
}
{ 
	isBlogPost && (
	<>
		<script async type="application/javascript" src="https://news.google.com/swg/js/v1/swg-basic.js"></script>
		<script is:inline>
  		  // @ts-ignore
			(self.SWG_BASIC = self.SWG_BASIC || []).push( basicSubscriptions => {
    			basicSubscriptions.init({
      			  type: "NewsArticle",
      			  isPartOfType: ["Product"],
      			  isPartOfProductId: `CAowk9PMDA:openaccess`,
      			  clientOptions: { theme: "light", lang: "id" },
    			});
  		  });
		</script>
	</>
	)
}