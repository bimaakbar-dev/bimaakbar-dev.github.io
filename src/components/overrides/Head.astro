---
import Default from "@astrojs/starlight/components/Head.astro";
import { Font } from "astro:assets";
import { SEO } from '~/constants';

const { 
  entry, 
  siteDescription, 
  isBlog, 
  rssUrl 
} = Astro.locals.starlightRoute;

const data = (entry?.data as any) || {};

let ogImage = "/og.jpg?v=1";

if (data.heroImage) {
  if (typeof data.heroImage === "string") ogImage = data.heroImage;
  else if (data.heroImage.src) ogImage = data.heroImage.src;
  else if (data.heroImage.file?.src) ogImage = data.heroImage.file.src;
}

const hasManualOg = data.head?.some(
  (h: any) => h.attrs?.property === "og:image",
);

const absolutOg = (() => {
  try {
    return new URL(ogImage, Astro.site || Astro.url).href;
  } catch {
    return ogImage;
  }
})();

const ogImageAlt = data.title || siteDescription;
---

<Font cssVariable="--font-montserrat" preload />
<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-firaCode" preload />

<Default>
	<slot />
</Default>

{isBlog && (
	<link
		rel="alternate"
		type="application/rss+xml"
		title="RSS Feed"
		href={rssUrl as string}
	/>
)}

{!hasManualOg && entry && (
	<>
      <meta property="og:image" content={absolutOg} />
      <meta property="og:image:alt" content={ogImageAlt} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content={absolutOg} />
      <meta name="twitter:image:alt" content={ogImageAlt} />
    </>
)}
{import.meta.env.PRODUCTION && (
  <meta name="google-site-verification" content={SEO.verification.google} />
  <meta name="msvalidate.01" content={SEO.verification.bing} />
  <meta name="yandex-verification" content={SEO.verification.yandex} />
  <!--<meta name="google-adsense-account" content={SEO.ads.google} />-->
  <!--<meta name="monetag" content={SEO.ads.monetag} />-->

  <script is:inline>
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
      var f = d.getElementsByTagName(s)[0], j = d.createElement(s), 
      dl = l != "dataLayer" ? "&l=" + l : ""; 
      j.async = true; 
      j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
      f.parentNode.insertBefore(j, f);
    })(window, document, "script", "dataLayer", "GTM-NJJPZV2M");
  </script>
)}