---
// src/components/overrides/Hero.astro

import Default from "@astrojs/starlight/components/Hero.astro";
import { PAGE_TITLE_ID } from "~/constants";
import { LinkButton } from "@astrojs/starlight/components";

const { entry, isDocsIndex, isBlogIndex } = Astro.locals.starlightRoute;

const data = entry.data as any;

const { title, hero } = data;

const actions = hero?.actions || [];

const customHero = isDocsIndex || isBlogIndex;
---

{
  customHero ? (
    <div class="custom-hero lg:py-18 relative z-10 py-12 sm:py-14 md:py-16 xl:py-20 border-b border-(--sl-color-gray-5)">
      <div class="absolute inset-x-0 top-0 h-px w-full bg-linear-to-r from-transparent via-(--sl-color-accent-high) to-transparent opacity-50" />
      <div class="pointer-events-none absolute inset-0 z-0 bg-[linear-gradient(rgba(128,128,128,0.1)_1px,transparent_1px),linear-gradient(90deg,rgba(128,128,128,0.1)_1px,transparent_1px)] mask-[radial-gradient(ellipse_80%_80%_at_50%_0%,#000_40%,transparent_100%)] bg-size-[24px_24px]" />
      <div class="relative sl-flex flex-col flex-1 items-center gap-6 text-center z-20">
        <h1
          id={PAGE_TITLE_ID}
          class="custom-hero-title mx-auto max-w-5xl text-(--sl-text-h3) sm:text-(--sl-text-h2) lg:text-(--sl-text-h1)"
          set:html={hero?.title || title}
        />
        {hero?.tagline && (
          <p
            class="custom-hero-tagline text-(--sl-color-gray-2)"
            set:html={hero.tagline}
          />
        )}
        {actions.length > 0 && (
          <div class="sl-flex custom-hero-actions">
            {actions.map((action: any) => {
              const { text, link: href, variant, icon, attrs = {} } = action;
              const { class: className, ...restAttrs } = attrs;
              const iconName = typeof icon === 'string' ? icon : icon?.name;
              return (
                <LinkButton
                  href={href}
                  variant={variant}
                  icon={iconName}
                  class:list={[className]}
                  {...restAttrs}
                >
                  {text}
                </LinkButton>
              );
            })}
          </div>
        )}
      </div>
    </div>
  ) : (
    <Default />
  )
}

<style>
  .custom-hero {
    row-gap: 6rem;
    width: 100%;
    padding-bottom: 6rem;
    display: grid;
    overflow: clip;
  }

  .custom-hero-title {
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
    margin: 0;
  }

  .custom-hero-tagline {
    font-size: var(--sl-text-body);
    font-weight: 300;
    line-height: var(--sl-line-height);
  }

  .custom-hero-actions {
    gap: 1rem 2rem;
	flex-wrap: wrap;
	justify-content: center;
  }
</style>

<style is:global>
  .content-panel .sl-container header {
    max-width: 52rem !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative;
    z-index: 10;
  }
  .content-panel + .content-panel {
    border-top: 1px solid var(--sl-color-gray-5);
    max-width: 52rem !important;
    margin-inline: auto;
  }
</style>