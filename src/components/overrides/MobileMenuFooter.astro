---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import ThemeSelect from './ThemeSelect.astro';
import GithubStar from '~/stradocs/components/GithubStar.astro';

const GithubRepo = 'c0desk1/c0desk1.github.io';
---

<div class="mobile-preferences sl-flex">
	<div class="footer-select sl-flex">
		<ThemeSelect />
		<LanguageSelect />
	</div>
	<div class="social-icons sl-flex">
        <GithubStar repo={GithubRepo} />
    </div>
</div>

<style>
  .mobile-preferences {
    justify-content: space-between;
	flex-wrap: wrap;
	column-gap: 1rem;
	margin-block-end: env(safe-area-inset-bottom);
	margin-block-start: 1rem;
	padding-block: 1rem;
	align-items: center;
	& .footer-select {
      align-items: center;
	  gap: 0.75em;
	}
    & .social-icons {
	  margin-inline-start: auto;

	  align-items: center;
	}
  }
</style>
