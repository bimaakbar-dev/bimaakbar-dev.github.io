---
// @ts-nocheck
import config from 'virtual:starlight/user-config';
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import SocialIcons from "./SocialIcons.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import NavLinks from "~/components/NavLinks.astro";
import MobileMenu from "~/components/MobileMenu.astro";

const { isCustomMenu } = Astro.locals.starlightRoute;
const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header" data-is-custom-menu={isCustomMenu ? "true" : "false"}>
  <!-- KOLOM 1: Title + NavLinks -->
  <div class="left-group">
    <div class="title-wrapper sl-flex">
      <SiteTitle />
    </div>
    <div class="sl-hidden md:sl-flex print:hidden nav-group leading-none">
      <NavLinks />
    </div>
  </div>

  <!-- KOLOM 2: Spacer otomatis dari grid (1fr) -->

  <!-- KOLOM 3: Right Group -->
  <div class="sl-flex right-group">
    <div class="sl-flex print:hidden">
      {shouldRenderSearch && <Search />}
    </div>
    <div class="sl-hidden md:sl-flex print:hidden right-group">
      <div class="sl-flex social-icons">
        <SocialIcons />
      </div>
      <ThemeSelect />
      <LanguageSelect />
    </div>
  </div>
</div>

{isCustomMenu && <MobileMenu />}

<style>
  /* ===== MOBILE (flex) ===== */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: var(--sl-nav-gap);
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
  }

  .left-group {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
    flex: 1 1 auto;          /* ambil ruang tersisa */
    min-width: 0;
  }

  .title-wrapper {
    flex-shrink: 0;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  .nav-group,
  .right-group,
  .social-icons {
    gap: var(--sl-nav-gap);
    align-items: center;
  }

  /* Social separator */
  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }

  /* Padding kanan untuk tombol custom fixed di mobile */
  .header[data-is-custom-menu="true"] {
    padding-inline-end: calc(
      var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
    );
  }

  /* ===== DESKTOP (grid) ===== */
  @media (min-width: 50rem) {
    .header {
      display: grid;
      grid-template-columns: auto 1fr auto;  /* left-group | spacer | right-group */
      align-items: center;
      gap: var(--sl-nav-gap);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    }

    .left-group {
      grid-column: 1;
      display: flex;
      align-items: center;
      gap: var(--sl-nav-gap);
      flex: none;               /* ukuran sesuai konten */
    }

    .right-group {
      grid-column: 3;
      display: flex;
      align-items: center;
      gap: var(--sl-nav-gap);
      flex-shrink: 0;           /* tidak menyusut */
    }

    /* Reset padding kanan di desktop (tombol hidden) */
    .header[data-is-custom-menu="true"] {
      padding-inline-end: var(--sl-nav-pad-x);
    }

    /* Pastikan NavLinks tampil di desktop (override md:sl-hidden) */
    .nav-group {
      display: flex !important;
    }

    /* Hilangkan border-bottom bawaan jika perlu */
    :global(header) {
      border-bottom: none;
    }
  }
</style>