---
// src/components/overrides/Header.astro
// @ts-nocheck
import config from 'virtual:starlight/user-config';

import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import SocialIcons from "./SocialIcons.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import NavLinks from "~/components/NavLinks.astro";
import MobileMenu from "~/components/MobileMenu.astro";
import GithubStar from '~/components/GithubStar.astro';

const { isCustomMenu } = Astro.locals.starlightRoute;
const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header" data-is-custom-menu={isCustomMenu ? "true" : "false"}>
  <div class="sl-flex left-group">
    <div class="title-wrapper sl-flex">
      <SiteTitle />
    </div>
    <div class="sl-hidden md:sl-flex print:hidden nav-group leading-none flex-1">
      <NavLinks />
    </div>
  </div>
  <div class="sl-flex right-group">
    <div class="sl-flex print:hidden">
      {shouldRenderSearch && <Search />}
    </div>
    <div class="sl-hidden md:sl-flex print:hidden right-group" data-custom-hidden={isCustomMenu ? "true" : "false"}>
      <div class="sl-flex social-icons">
        <SocialIcons />
      </div>
      <ThemeSelect />
      <LanguageSelect />
    </div>
  </div>
</div>

{isCustomMenu ? (<MobileMenu />) : (<div aria-hidden="true" />)}

<style define:vars={{isCustomMenu}}>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }
  .title-wrapper {
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}
  .nav-group,
  .social-icons {
    gap: 1rem;
		align-items: center;
  }
  .social-icons::after {
		content: '';
		height: 2rem;
		border-inline-end: 1px solid var(--sl-color-gray-5);
	}

  .header[data-is-custom-menu="true"] {
		padding-inline-end: calc(
			var(--sl-nav-gap) + var(--sl-menu-button-size)
  	);
  }
  
  .right-group[data-is-custom-menu="true"][data-custom-hidden='true'] {
    display: none;
  }

  @media (min-width: 50rem) {
  .header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--sl-nav-gap);
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
  }
  .left-group {
    grid-column: 1;
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
  }
  .right-group {
    grid-column: 3;
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
    flex-shrink: 0;
  }
  /* reset padding custom jika ada */
  .header[data-is-custom-menu="true"] {
    padding-inline-end: 0;
  }
}
</style>