---
// src/components/overwrite/MarkdownContent.astro
import "@astrojs/starlight/style/markdown.css";

import Default from '@astrojs/starlight/components/MarkdownContent.astro';

import EditLink from "@astrojs/starlight/components/EditLink.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import Pagination from "@astrojs/starlight/components/Pagination.astro";

import RelatedPosts from "~/components/RelatedPosts.astro";
import MobileScrollToTop from "../MobileScrollToTop.astro";


const { entry, isBlogPost, isBlogIndex, isDocIndex } = Astro.locals.starlightRoute;
const customIndex = isBlogIndex || isDocIndex;
---

{
  isBlogPost ? (
    <article class="sl-markdown-content">
      <slot />
    </article>
    <div class="meta custom-meta sl-flex">
      <EditLink />
      <LastUpdated />
    </div>
    <Pagination />
    <RelatedPosts currentSlug={entry.id} />
    <MobileScrollToTop />
  ) : customIndex ? (
    <div class="not-content">
      <slot />
      <Pagination />
    </div>
  ) : (
    <Default>
      <slot />
      <MobileScrollToTop />
    </Default>
  )
}

<style>
  .meta {
    width: 100%;
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-top: 3rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .custom-meta {
    padding-inline: var(--sl-content-pad-x);
    border-block: 1px solid var(--sl-color-hairline);
    padding-block: 1rem;
  }
  .meta > :global(p:only-child) {
    margin-inline-start: auto;
  }
</style>