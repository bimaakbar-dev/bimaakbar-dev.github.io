---
// src/components/overwrite/MarkdownContent.astro
import "@astrojs/starlight/style/markdown.css";

import EditLink from "@astrojs/starlight/components/EditLink.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import Pagination from "@astrojs/starlight/components/Pagination.astro";

import RelatedPosts from "~/components/RelatedPosts.astro";
import MobileScrollToTop from "../MobileScrollToTop.astro";
import Comments from "~/stradocs/components/Comments.astro";


const { entry, isBlogPost, isBlogIndex, isDocIndex } = Astro.locals.starlightRoute;
const customIndex = isBlogIndex || isDocIndex;

---

{isBlogPost ? (
  <>
    <article class="sl-markdown-content">
      <slot />
    </article>
    <script async src="https://news.google.com/swg/js/v1/swg-basic.js"></script>
    <script is:inline>
      //@ts-ignore
      (self.SWG_BASIC = self.SWG_BASIC || []).push((basicSubscriptions) => {
        basicSubscriptions.init({
          type: "NewsArticle",
          isPartOfType: ["Product"],
          isPartOfProductId: "CAow3NjGDA:openaccess",
          clientOptions: { theme: "dark", lang: "id" },
        });
      });
    </script>
    <script src="https://quge5.com/88/tag.min.js" data-zone="266896" async data-cfasync="false"></script>
    <div rrm-inline-cta="1b7a649f-eb54-48c5-8106-f2ac499dfc5f"></div>
    <div class="custom-meta sl-flex">
      <EditLink />
      <LastUpdated />
    </div>
    <Pagination />
    <Comments />
    <RelatedPosts currentSlug={entry.id} />
    <hr />
    <MobileScrollToTop />
  </>
	) : customIndex ? (
	<div class="not-content">
		<slot />		
	</div>
	<Pagination />
  <hr />
	) : (
	<article class="sl-markdown-content">
		<slot />
	</article>
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>
	<Pagination />
	<MobileScrollToTop />
)}

<style>
  .meta {
    width: 100%;
    gap: 0.75em 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    margin-top: 3rem;
  }
  .custom-meta {
    width: 100%;
    gap: 0.75em 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    margin-top: 1rem;
    padding-block: var(--sl-content-gap-y);
  }
  :where(.meta, .custom-meta) > :global(p:only-child) {
    margin-inline-start: auto;
  }
  :global([data-has-sidebar][data-has-hero] hr) {
    display: none;
  }
</style>