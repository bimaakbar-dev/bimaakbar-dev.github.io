---
import type { TocItem } from '~/utils/generateToc';

interface Props {
  toc: TocItem[];
  depth?: number;
  isMobile?: boolean;
}

const { 
  toc, 
  isMobile = false, 
  depth = 0 
} = Astro.props;
---

<ul class:list={[{ isMobile }, depth === 0 && 'root']}>
  {
    toc.map((heading) => (
      <li>
        <a href={'#' + heading.slug}>
          <span>{heading.text}</span>
        </a>
        {heading.children.length > 0 && (
          <Astro.self toc={heading.children} depth={depth + 1} isMobile={isMobile} />
        )}
      </li>
    ))
  }
</ul>

<style define:vars={{ depth }}>
  @layer starlight.core {
    ul {
      padding: 0;
      list-style: none;
      font-weight: 500;
      position: relative;
    }

    li {
      position: relative;
    }

    /* Garis vertikal continuous di semua level */
    ul::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 1.25rem;
      width: 1px;
      background-color: var(--sl-color-hairline-light);
      border-radius: 99rem;
    }

    /* Root ul — garis lebih ke kiri */
    ul.root::before {
      left: 0.4rem;
    }

    /* Dot di setiap li — default transparent */
    li::before {
      content: "";
      position: absolute;
      top: 50%;
      left: calc(1.25rem - 0.2rem);
      transform: translateY(-50%);
      width: 0.4rem;
      height: 0.4rem;
      border-radius: 50%;
      background-color: transparent;
      transition: background-color 0.2s ease;
      z-index: 1;
    }

    /* Root li dot lebih ke kiri */
    ul.root > li::before {
      left: calc(0.4rem - 0.2rem);
    }

    /* Active dot */
    li:has(> a[aria-current="true"])::before {
      background-color: var(--sl-color-text-accent);
      /* Garis accent dari dot ke atas — arus yang sudah lewat */
      box-shadow: 0 -999px 0 0.5px var(--sl-color-text-accent);
    }

    a {
      --pad-inline: 0.5rem;
      display: block;
      border-radius: 0.5rem;
      padding-block: 0.5rem;
      padding-inline: calc(1rem * var(--depth) + var(--pad-inline) + 0.75rem) var(--pad-inline);
      line-height: 1.25;
    }
    a:hover {
      background-color: rgb(from var(--sl-color-gray-6) r g b / 50%);
    }
    a[aria-current='true'],
    a[aria-current='true']:focus {
      color: var(--sl-color-text-accent);
      background-color: rgb(from var(--sl-color-gray-6) r g b / 50%);
    }

    /* Mobile */
    .isMobile a {
      --pad-inline: 1rem;
      display: flex;
      justify-content: space-between;
      gap: var(--pad-inline);
      border-top: 0;
      border-radius: 0.5rem;
      padding-block: 0.5rem;
      color: var(--sl-color-text);
      font-size: var(--sl-text-xs);
      text-decoration: none;
      outline-offset: var(--sl-outline-offset-inside);
    }
    .isMobile a[aria-current='true'],
    .isMobile a[aria-current='true']:hover,
    .isMobile a[aria-current='true']:focus {
      color: var(--sl-color-text-accent);
      background-color: rgb(from var(--sl-color-gray-6) r g b / 50%);
    }
    .isMobile a[aria-current='true']::after {
      content: '';
      width: 1rem;
      background-color: var(--sl-color-text-accent);
      -webkit-mask-image: url('data:image/svg+xml;base64,');
      mask-image: url('data:image/svg+xml;base64,');
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      flex-shrink: 0;
    }

    @media (min-width: 50rem) {
      ul::before {
        left: 0.75rem;
      }
      ul.root::before {
        left: 0.4rem;
      }
      li::before {
        left: calc(0.75rem - 0.2rem);
      }
      ul.root > li::before {
        left: calc(0.4rem - 0.2rem);
      }
    }
  }
</style>

<style is:global>
  starlight-toc ul,
  mobile-starlight-toc ul {
    position: relative;
  }
  starlight-toc li,
  mobile-starlight-toc li {
    position: relative;
  }
</style>