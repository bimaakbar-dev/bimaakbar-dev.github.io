---
import { Icon } from "@astrojs/starlight/components";
---

<button
  popovertarget="starlight__sidebar"
  class="sl-menu-button sl-flex md:sl-hidden print:hidden"
>
  <div class="inline-flex items-center shrink-0 justify-center icon-wrapper">
    <Icon name="bars" class="open-menu" />
    <Icon name="close" class="close-menu" />
  </div>
  <span class="sr-only">{Astro.locals.t("menuButton.accessibleLabel")}</span>
</button>

<style>
  @layer starlight.core {
    button {
      position: fixed;
      top: calc((var(--sl-nav-height) - var(--sl-menu-button-size)) / 2);
      inset-inline-end: var(--sl-nav-pad-x);
      z-index: var(--sl-z-index-navbar);
      width: var(--sl-menu-button-size);
      height: var(--sl-menu-button-size);
      padding: 0.25rem;
      border-radius: 0.5rem;
      background-color: transparent;
      color: var(--sl-color-white);
      box-shadow: none;
      cursor: pointer;
      align-items: center;
      justify-content: center;
      display: flex;
      flex-shrink: 0;
    }

    button .icon-wrapper svg {
      width: 1.5rem !important;
      height: 1.5rem !important;
      flex-shrink: 0;
    }

    button:has(~ :popover-open) {
      background-color: transparent;
      color: var(--sl-color-white);
      box-shadow: none;
    }

    button:has(~ :popover-open) .open-menu {
      display: none;
    }

    button:not(:has(~ :popover-open)) .close-menu {
      display: none;
    }
  }
</style>

<style is:global>
  @layer starlight.core {
    body:has(#starlight__sidebar:popover-open) {
      overflow: hidden;
    }

    @media (min-width: 50rem) {
      body:has(#starlight__sidebar:popover-open) {
        overflow: auto;
      }
    }
  }
</style>
