---
import { Icon } from "@astrojs/starlight/components";
---

<button popovertarget="starlight__sidebar" class="sl-menu-button sl-flex md:sl-hidden print:hidden">
  <svg xmlns="http://www.w3.org/2000/svg" height="16" width="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true" class="open-menu">
	  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5"></path>
  </svg>
  <Icon name="close" class="close-menu" size="1em" />
  <span class="sr-only">{Astro.locals.t("menuButton.accessibleLabel")}</span>
</button>

<style>
	@layer starlight.core {
		button {
			position: fixed;
			top: calc((var(--sl-nav-height) - var(--sl-menu-button-size)) / 2);
			inset-inline-end: var(--sl-nav-pad-x);
			z-index: var(--sl-z-index-navbar);
			width: var(--sl-menu-button-size);
			height: var(--sl-menu-button-size);
			border: 0;
			padding: 0;
			border-radius: 50%;
			background-color: transparent;
			color: var(--sl-color-white);
			box-shadow: none;
			cursor: pointer;
			align-items: center;
			justify-content: center;
			& svg {
				flex-shrink: 0;
				width: 1.333em;
				height: 1.333em;
				font-size: inherit;
			}
			&:has(~ :popover-open) {
				background-color: transparent;
				color: var(--sl-color-white);
				box-shadow: none;
				& .open-menu {
					display: none;
				}
			}
			&:not(:has(~ :popover-open)) .close-menu {
				display: none;
			}
		}
		:global([data-theme='light']) button {
			background-color: transparent;
			color: var(--sl-color-white);
			box-shadow: none;
			&:has(~ :popover-open) {
				background-color: transparent;
			}
		}
	}
</style>

<style is:global>
  @layer starlight.core {
    body:has(#starlight__sidebar:popover-open) {
      overflow: hidden;
    }

    @media (min-width: 50rem) {
      body:has(#starlight__sidebar:popover-open) {
        overflow: auto;
      }
    }
  }
</style>