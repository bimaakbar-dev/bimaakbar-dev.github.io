---
import Default from '@astrojs/starlight/components/ContentPanel.astro';

const { 
  isBlogPost, 
  isBlogIndex 
} = Astro.locals.starlightRoute;
---
{
    isBlogIndex ? (
        <div class="custom-content-panel">
            <div class="sl-custom-container">
                <slot />
            </div>
        </div>
    ) : isBlogPost ? (
		<div class="custom-blog-post-content-panel">
            <div class="sl-blog-container">
                <slot />
            </div>
        </div>
    ) : (
        <Default><slot/></Default>
    )
}

<style define:vars={{isBlogIndex}}>
  .custom-content-panel {
    padding: 0;
	& + .custom-content-panel {
	  border-top: 1px solid var(--sl-color-hairline);
	}
  }
  .sl-custom-container {
	max-width: 100dvw;
	& > :global(* + *) {
	  margin-top: 0;
	}
  }

  @media (min-width: 72rem) {
    .sl-custom-container {
      margin-inline: var(--sl-content-margin-inline, auto);
	}
  }
</style>

<style define:vars={{isBlogPost}}>
  .custom-blog-post-content-panel {
    padding-block: 0;
	padding-inline: 0;
	max-width: 100dvw;
	& + .custom-blog-post-content-panel {
	  border-top: 1px solid var(--sl-color-hairline);
	  padding-block: 1.5rem;
	  padding-inline: var(--sl-content-pad-x);
	  max-width: 50rem;
	  margin-inline: auto;
	}
	& .sl-blog-container {
		position: relative;
		margin-inline: auto;
	}
	& :global(.sl-blog-container .blog-post-header) {
		max-width: 50rem;
	}
	& .sl-blog-container > :global(* + *) {
		margin-top: 1.5rem;
	}
  }
  @media (min-width: 72rem) {
    .sl-blog-container {
	  margin-inline: var(--sl-content-margin-inline, auto);
	}
  }
</style>

<style>
	:global(:is([data-has-sidebar][data-has-hero] .sl-container)) {
        max-width: 100dvw;
		margin-inline: auto;
		
    }
	@media (min-width: 50rem) {
		:global(:is([data-has-sidebar][data-has-hero] .sl-container)) {
			max-width: calc( 100dvw - var(--sl-sidebar-width));
			margin-inline-start: var(--sl-sidebar-width);
			padding-inline: var(--sl-content-pad-x);
		}
	}
</style>