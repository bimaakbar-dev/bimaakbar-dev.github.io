---
import { Image } from "astro:assets";
import { PAGE_TITLE_ID } from "~/constants";
import { getReadingTime } from "~/utils/readingTime";
import FormattedDate from "../FormattedDate.astro";
import DocsActions from '../DocsActions.astro'
import Breadcrumb from "../Breadcrumb.astro";

const { 
	entry,
	docsBasePath, 
	isBlogPost 
} = Astro.locals.starlightRoute

const {
  title,
  description,
  pubDate,
  heroImage,
  author = [],
} = entry.data;

const breadcrumbItems = [
  { label: Astro.locals.t("nav.docs"), href: `${docsBasePath}` },
  { label: entry.data.title, href: `/${entry.id}` },
];

const readingTime = getReadingTime(entry.body ?? '');
---

{ isBlogPost ? (
  <div class="hero-image not-content">
    {heroImage && (
      <Image
        width={1500}
        height={643}
        src={heroImage}
        class="sl-block"
        alt={title}
        loading="eager"
        decoding="async"
        fetchpriority='high'
        quality='high' 
        fit='cover' 
        position='center'
      />
    )}
  </div>
  <header class="blog-post-header sl-flex">
    <div class="post-meta sl-flex">
			{pubDate && <FormattedDate date={pubDate} class="post-date" />}
			{readingTime && <p class="post-reading-time">{readingTime.text} {Astro.locals.t("plugin.readingTime")}</p>}
		</div>
		<h1 id={PAGE_TITLE_ID} class="post-title" set:html={title} />
    {author && (
      <div class="post-author sl-flex">
        <span>{Astro.locals.t("blog.PostAuthor")}</span>
        <ul class="sl-flex not-content">
          {author.map((a) => (
            <li class="sl-flex">
              {a.avatar && (
                <Image
                  src={a.avatar}
                  width={48}
                  height={48}
                  alt={a.name || ''}
                  loading="eager"
                  decoding="async"
                  fetchpriority="low"
                  quality='mid' 
                  fit='cover' 
                  position='center'
                />
              )}
              <span>{a.name}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
	</header>
	) : (
  <header class="page-title sl-flex">
		<Breadcrumb items={breadcrumbItems} />
		<h1 id={PAGE_TITLE_ID} class="title" set:html={title} />
		{description && <p class="description" set:html={description} />}
		<div class="page-actions sl-flex">
			<DocsActions />
		</div>
	</header>
)}

<style>
  .hero-image {
    margin-inline: auto;
    width: 100%;
    max-width: 72rem;
    position: relative;
    z-index: 0;
    & img {
      width: 100%;
      height: auto;
      min-height: 15rem;
	  object-fit: cover;
    }
  }
  .blog-post-header {
    position: relative;
    flex-direction: column;
    margin-inline: auto;
    flex: 1;
    width: 100%;
    text-align: center;
    padding: 1rem 1.5rem;
    background: var(--sl-color-black);
    z-index: 10;
    border-top-left-radius: 1rem;
    border-top-right-radius: 1rem;
    & :where(.post-meta .post-date, .post-meta .post-reading-time, .post-author) {
      font-size: var(--sl-text-body);
      font-weight: 500;
      line-height: var(--sl-line-height);
      color: var(--sl-color-gray-2);
      font-family: var(--font-firaCode);
    }
    & .post-meta {
      margin-inline: auto;
      width: max-content;
      align-items: center;
      gap: 0.5rem;
      & .post-reading-time {
        white-space: nowrap;
        &::before {
          content: '•';
          padding-inline-end: 0.5em;
          color: var(--sl-color-gray-3);
        }
      }
    }
    & .post-title {
      font-size: var(--sl-text-h2);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
      color: var(--sl-color-white);
      text-align: center;
      margin-block: 0.5rem;
    }
    & .post-author {
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 0.75rem 1rem;
      padding-inline: var(--sl-content-pad-x);
      & ul {
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 0.75rem;
        list-style: none;
        padding: 0;
        margin: 0;
        & li {
          align-items: center;
          gap: 0.5rem;
          & > img {
            margin: 0;
            display: inline-block;
            border-radius: 99rem;
            width: 1.75em;
            height: 1.75em;
            box-shadow: inset 0 0 0 1px var(--sl-color-hairline);
          }
        }
      }
    }
  }
  .page-title {
    flex-direction: column;
    gap: 1rem;
    flex: 1;
    & .title {
      font-size: var(--sl-text-h1);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
      color: var(--sl-color-white);
      margin: 0
    }
    & .description {
      font-size: var(--sl-text-sm);
      line-height: var(--sl-line-height);
      color: var(--sl-color-gray-2);
      margin: 0
    }
    & .page-actions {
      margin-block-start: auto;
      gap: 0.75rem 0.35rem;
    }
  }
  @media (min-width: 50rem) {
    .hero-image {
      margin-bottom: -3rem;
    }
    .blog-post-header .post-author > ul li > img {
      width: 2.5em;
      height: 2.5em;
    }
  }
  @media (min-width: 72rem) {
    .hero-image {
      margin-bottom: -6rem;
    }
  }
</style>
