---
// PageTitle.astro
import { Image } from "astro:assets";
import { PAGE_TITLE_ID } from "~/constants";
import FormattedDate from "~/components/FormattedDate.astro";
import DocsActions from '../DocsActions.astro'

const { entry, isBlogPost } = Astro.locals.starlightRoute;

const { title, description, pubDate, heroImage, author = [], minutesRead } = entry.data;

const fullMarkdown = `# ${title}\n\n${entry.body || ''}`;
---

{
  isBlogPost ? (
    <>
      <div class="mx-auto w-full max-w-5xl md:-mb-10 lg:-mb-12 xl:-mb-16">
        {heroImage && (
          <Image
            width={1500}
            height={643}
            src={heroImage}
            class="min-h-60 h-full w-full object-cover"
            alt={title}
            loading="eager"
            decoding="async"
          />
        )}
      </div>
      <header class="mx-auto w-full text-center bg-(--sl-color-bg) md:z-10 relative p-6">
        {pubDate && <FormattedDate date={pubDate} class="post-date" />}
        <h1
          id={PAGE_TITLE_ID}
          class="post-title mb-4 mt-2 sm:mb-5 sm:mt-3"
          set:html={title}
        />
        <div class="post-author flex flex-wrap items-center justify-center gap-x-3 gap-y-2 px-(--sl-content-pad-x)">
          <span>{Astro.locals.t("blog.PostAuthor")}</span>
          <ul class="flex flex-wrap items-center gap-y-6 gap-x-4 list-none p-0 m-0 not-content">
            {author.map((a) => (
              <li class="flex items-center gap-2 p-0">
                {a.avatar && (
                  <Image
                    src={a.avatar}
                    width={48}
                    height={48}
                    class="my-0 inline-block rounded-full ring ring-(--sl-color-accent) size-6 md:size-8"
                    alt={a.name || title}
                    loading="eager"
                    decoding="async"
                    aria-hidden="true"
                  />
                )}
                <span>{a.name}</span>
              </li>
            ))}
          </ul>
          {minutesRead && (
            <p class="post-reading-time">
              {Astro.locals.t('blog.readingTime', { minutes: minutesRead })}
            </p>
          )}
        </div>
      </header>
    </>
  ) : (
    <div class="sl-flex flex-col">
      <h1
        id={PAGE_TITLE_ID}
        class="title mb-2"
        set:html={title}
      />
      {description && (
        <p class="description text-(--sl-color-gray-2) max-w-3xl mt-1" set:html={description} />
      )}
      <div class="page-actions flex gap-2">
        <DocsActions
          rawMarkdown={fullMarkdown}
        />
      </div>
    </div>
  )
}

<style>
  .title {
    font-size: var(--sl-text-h1);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
    text-align: start;
  }

  .description {
    font-size: var(--sl-text-sm);
    line-height: var(--sl-line-height);
    color: var(--sl-color-gray-2);
  }

  .post-title {
    font-size: var(--sl-text-h2);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
    text-align: center;
  }

  .post-date,
  .post-author,
  .post-reading-time {
    font-size: var(--sl-text-body);
    font-weight: 500;
    line-height: var(--sl-line-height);
    color: var(--sl-color-text);
    font-family: var(--__sl-font-mono);
  }

  .post-reading-time {
    white-space: nowrap;
  }

  .post-reading-time::before {
    content: '·';
    padding-inline-end: 0.5rem;
    color: var(--sl-color-gray-3);
  }

  .page-actions {
    display: flex;
    gap: 1rem 0.5rem;
    margin-top: 0.75rem
  }

  @media (min-width: 50rem) {
    .post-title {
      font-size: var(--sl-text-h1);
    }
  }
</style>