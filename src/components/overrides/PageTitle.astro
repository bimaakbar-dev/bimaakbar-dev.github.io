---
import { Image } from "astro:assets";
import { PAGE_TITLE_ID } from "~/constants";
import { getReadingTime } from "~/utils/readingTime";
import FormattedDate from "../FormattedDate.astro";
import DocsActions from '../DocsActions.astro'
import Breadcrumb from "../Breadcrumb.astro";

interface Props {
  heroImage?: ImageMetadata | string;
  author?: {
    name?: string;
    avatar?: ImageMetadata;
  }[];
}

const { 
	entry,
	docsBasePath, 
	isBlogPost,
  isLegalPage
} = Astro.locals.starlightRoute

const {
  title,
  description,
  pubDate,
  heroImage,
  author = [],
} = entry.data;

const breadcrumbItems = [
  { label: Astro.locals.t("nav.docs"), href: `${docsBasePath}` },
  { label: entry.data.title, href: `/${entry.id}` },
];

const readingTime = getReadingTime(entry.body ?? '');
---

{
  isBlogPost ? (
  <div class="hero-image not-content">
    {heroImage && ( 
      <Image
        width={1500}
        height={643}
        src={heroImage}
        class="sl-block"
        alt={title}
        loading="eager"
        decoding="async"
        fetchpriority='high'
        quality='high' 
        fit='cover' 
        position='center'
      />
    )}
  </div>
  <header class="blog-post-header sl-flex">
    <div class="post-meta sl-flex">
			{pubDate && <FormattedDate date={pubDate} class="post-date" />}
			{readingTime && <p class="post-reading-time">{readingTime.text} {Astro.locals.t("plugin.readingTime")}</p>}
		</div>
		<h1 id={PAGE_TITLE_ID} class="post-title" set:html={title} />
    {author && author.length > 0 && (
      <div class="post-author sl-flex">
        <span>{Astro.locals.t("blog.PostAuthor")}</span>
        <div class="author-group sl-flex not-content">
          <ul class="author-avatars sl-flex">
            {author.map((a: any, index: number) =>
              a.avatar ? (
                <li class="avatar-item" style={`z-index: ${index + 1}`}>
                  <Image
                    src={a.avatar}
                    width={48}
                    height={48}
                    alt={a.name || ''}
                    loading="eager"
                    decoding="async"
                    fetchpriority="low"
                    quality="mid"
                    fit="cover"
                    position="center"
                  />
                </li>
              ) : null
            )}
          </ul>
          <p class="author-names">
            {author.map((a: any) => a.name).filter(Boolean).join(', ')}
          </p>
        </div>
      </div>
    )}
	</header>
    ) : isLegalPage ? (
      <header class="legal-page-header sl-flex">
        <h1 id="_top" class="legal-title">{entry.data.title}</h1>
        {entry.data.description && (
          <p class="legal-description">{entry.data.description}</p>
        )}
      </header>
    ) : (
    <header class="page-title sl-flex">
      <Breadcrumb items={breadcrumbItems} />
      <h1 id={PAGE_TITLE_ID} class="title" set:html={title} />
      {description && <p class="description" set:html={description} />}
      <div class="page-actions sl-flex">
        <DocsActions />
      </div>
    </header>
  )
}

<style>
  .hero-image {
    margin-inline: auto;
    width: 100%;
    max-width: 72rem;
    position: relative;
    z-index: 0;
    margin-bottom: -1rem;
    & img {
      width: 100%;
      height: auto;
      min-height: 18rem;
      object-fit: cover;
    }
  }

  .blog-post-header {
    position: relative;
    flex-direction: column;
    margin-inline: auto;
    flex: 1;
    width: 100%;
    text-align: center;
    padding-inline: var(--sl-content-pad-x);
    padding-block: var(--sl-content-gap-y);
    background: var(--sl-color-black);
    z-index: 10;
    border-top-left-radius: 0.75rem;
    border-top-right-radius: 0.75rem;
    & :where(.post-meta .post-date, .post-meta .post-reading-time, .post-author) {
      font-size: var(--sl-text-body);
      font-weight: 500;
      color: var(--sl-color-gray-2);
      font-family: var(--font-firaCode);
    }
    & .post-meta {
      margin-inline: auto;
      width: max-content;
      align-items: center;
      gap: 0.5rem;
      & .post-reading-time {
        white-space: nowrap;
        &::before {
          content: '•';
          padding-inline-end: 0.5em;
          color: var(--sl-color-gray-3);
        }
      }
    }
    & .post-title {
      font-size: var(--sl-text-h2);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
      color: var(--sl-color-white);
      text-align: center;
      margin-block: 0.5rem;
      text-wrap: balance;
    }
    & .post-author {
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 0.75rem 1rem;
      & .author-group {
        align-items: center;
        gap: 0.75rem;
      }
      & .author-avatars {
        list-style: none;
        padding: 0;
        margin: 0;
        align-items: center;
        isolation: isolate;
        & .avatar-item {
          position: relative;
          line-height: 0;
          & + .avatar-item {
            margin-inline-start: -0.5em;
          }
          & > img {
            margin: 0;
            display: block;
            border-radius: 99rem;
            width: 1.5em;
            height: 1.5em;
            object-fit: cover;
            background: var(--sl-color-gray-6);
            box-shadow:
              0 0 0 2px var(--sl-color-black),
              inset 0 0 0 1px var(--sl-color-black);
          }
        }
      }
      & .author-names {
        margin: 0;
      }
    }
  }

  .page-title {
    flex-direction: column;
    gap: 1rem;
    flex: 1;
    & .title {
      font-size: var(--sl-text-h1);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
      color: var(--sl-color-white);
      margin: 0;
      text-wrap: balance;
    }
    & .description {
      font-size: var(--sl-text-sm);
      line-height: var(--sl-line-height);
      color: var(--sl-color-gray-2);
      margin: 0;
      text-wrap: pretty;
    }
    & .page-actions {
      margin-block-start: auto;
      gap: 0.75rem 0.35rem;
    }
  }

  .legal-page-header {
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: 2rem;
    padding-inline: var(--sl-content-pad-x);
    gap: 0.75rem;
    flex: 1
  }

  .legal-title {
    font-size: var(--sl-text-h1);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
    margin: 0;
  }

  .legal-description {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    margin: 0;
    max-width: 50ch;
    text-wrap: balance;
  }

  [data-theme='light'] .blog-post-header .post-author .author-avatars .avatar-item > img {
    background: var(--sl-color-gray-7);
  }

  @media (min-width: 50rem) {
    .hero-image {
      margin-bottom: -3rem;
    }
    .blog-post-header {
      padding-block: var(--sl-content-gap-y);
    }
    .blog-post-header .post-author .author-avatars .avatar-item > img {
      width: 2rem;
      height: 2rem;
    }
  }
  @media (min-width: 72rem) {
    .hero-image {
      margin-bottom: -6rem;
    }
  }
</style>
