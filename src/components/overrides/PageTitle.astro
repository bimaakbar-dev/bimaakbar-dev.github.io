---
import { Image } from "astro:assets";
import { PAGE_TITLE_ID } from "~/constants";
import { getReadingTime } from "~/utils/readingTime";
import FormattedDate from "../FormattedDate.astro";
import DocsActions from '../DocsActions.astro'
import Breadcrumb from "../Breadcrumb.astro";

const { entry, docsBasePath, isBlogPost } = Astro.locals.starlightRoute

const {
  title,
  description,
  pubDate,
  heroImage,
  author = [],
} = entry.data;

const breadcrumbItems = [
  { label: Astro.locals.t("nav.docs"), href: `${docsBasePath}` },
  { label: entry.data.title, href: `/${entry.id}` },
];

const rt = getReadingTime(entry.body ?? '');
---

{
  isBlogPost ? (
    <div class="hero-image not-content">
      {heroImage && (
        <Image
          width={1500}
          height={643}
          src={heroImage}
          class="sl-block"
          alt={title}
          loading="eager"
          decoding="async"
        />
      )}
    </div>
    <header class="blog-post-header">
      {pubDate && <FormattedDate date={pubDate} class="post-date" />}

      <h1 id={PAGE_TITLE_ID} class="post-title" set:html={title} />

      {author && (
        <div class="post-author sl-flex">
          <span>{Astro.locals.t("blog.PostAuthor")}</span>
          <ul class="sl-flex not-content">
            {author.map((a) => (
              <li class="sl-flex">
                {a.avatar && (
                  <Image
                    src={a.avatar}
                    width={48}
                    height={48}
                    alt={a.name || title}
                    loading="eager"
                    decoding="async"
                    aria-hidden="true"
                  />
                )}
                <span>{a.name}</span>
              </li>
            ))}
          </ul>

          {rt && <p class="post-reading-time">{rt.text} {Astro.locals.t("plugin.readingTime")}</p>}
          
        </div>
      )}
    </header>
  ) : (
    <div class="sl-flex page-title">
      <Breadcrumb items={breadcrumbItems} />
      <h1 id={PAGE_TITLE_ID} class="title" set:html={title} />
      {description && (
        <p class="description" set:html={description} />
      )}
      <div class="page-actions sl-flex">
        <DocsActions />
      </div>
    </div>
  )
}

<style define:vars={{isBlogPost}}>
  .hero-image {
    margin-inline: auto;
    width: 100%;
    max-width: 72rem;
    position: relative;
    z-index: 0;
    & img {
      object-fit: cover;
      width: 100%;
      height: auto;
      min-height: 15rem;
    }
  }
  .blog-post-header {
    position: relative;
    flex-direction: column;
    margin-inline: auto;
    width: 100%;
    text-align: center;
    padding: 1rem 1.5rem;
    background: var(--sl-color-black);
    z-index: 10;
    border-top-left-radius: 1rem;
    border-top-right-radius: 1rem;
    & .post-title {
      font-size: var(--sl-text-h2);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
      color: var(--sl-color-white);
      text-align: center;
      margin-block: 0.5em;
    }
    & :where(.post-date, .post-author, .post-reading-time) {
      font-size: var(--sl-text-body);
      font-weight: 500;
      line-height: var(--sl-line-height);
      color: var(--sl-color-gray-2);
      font-family: var(--__sl-font-mono);
    }
    & .post-author {
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 0.75em 1em;
      padding-inline: var(--sl-content-pad-x);
      & ul {
        flex-wrap: wrap;
        align-items: center;
        gap: 1em 0.75em;
        list-style: none;
        padding: 0;
        margin: 0
      }
      & ul li {
        align-items: center;
        gap: 0.5em;
      }
      & ul li > img {
        margin: 0;
        display: inline-block;
        border-radius: 99rem;
        width: 1.5em;
        height: 1.5em;
        box-shadow: inset 0 0 0 1px var(--sl-color-hairline-shade);
      }
    }
    & .post-reading-time {
      white-space: nowrap;
    }
    & .post-reading-time::before {
      content: '•';
      padding-inline-end: 0.5em;
      color: var(--sl-color-gray-3);
    }
  }
  .page-title {
    flex-direction: column;
    gap: 1rem;
    flex: 1;
    & .title {
      font-size: var(--sl-text-h1);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
      color: var(--sl-color-white);
      margin: 0
    }
    & .description {
      font-size: var(--sl-text-sm);
      line-height: var(--sl-line-height);
      color: var(--sl-color-gray-2);
      margin: 0
    }
    & .page-actions {
      margin-block-start: auto;
      gap: 0.75em 0.35em;
    }
  }
  @media (min-width: 50rem) {
    .hero-image {
      margin-bottom: -3rem;
    }
    .page-title .post-title {
      font-size: var(--sl-text-h1);
    }
    .blog-post-header .post-author > ul li > img {
      width: 2em;
      height: 2em;
    }
  }
  @media (min-width: 72rem) {
    .hero-image {
      margin-bottom: -6rem;
    }
  }
</style>