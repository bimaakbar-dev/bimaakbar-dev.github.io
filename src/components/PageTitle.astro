---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { Image } from 'astro:assets';
import FormattedDate from '~/components/FormattedDate.astro';

const isBlogPost =
  Astro.url.pathname.startsWith('/blog/') &&
  Astro.url.pathname !== '/blog/';

const meta = Astro.locals.blogMeta;
---

{isBlogPost && meta ? (
  <div class="blog-header-meta">
    {meta.heroImage && (
      <Image
        src={meta.heroImage}
        alt="Blog Hero Image"
        class="hero-image"
      />
    )}

    {meta.pubDate && (
      <div class="date">
        <FormattedDate date={meta.pubDate} />
      </div>
    )}

    <Default />

    {meta.author && (
      <div class="author-info">
        <span>{Astro.locals.t('component.blogPostAuthor')}</span>
        <img
          src={meta.author.avatar}
          alt={meta.author.name}
          class="author-avatar"
        />
        <span class="author-name">{meta.author.name}</span>
      </div>
    )}
  </div>
) : (
  <Default />
)}

<style>
  @layer starlight.core {
    .blog-header-meta {
      margin-bottom: 0;
      text-align: center;
    }

    .hero-image {
      width: 100%;
      height: auto;
      max-height: 400px;
      object-fit: cover;
      /* border-radius: 0.5rem; */
      margin-bottom: 1.25rem;
    }

    .date {
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
      margin-bottom: 0.75rem;
    }

    .author-info {
      display: flex;
      align-items: center;
      text-align: center;
      gap: 0.5rem;
      margin-top: 0.75rem;
      font-size: var(--sl-text-sm);
    }

    .author-avatar {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      object-fit: cover;
    }

    .author-name {
      color: var(--sl-color-gray-2);
      font-weight: 500;
    }
  }
</style>