---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { Image } from 'astro:assets';
import FormattedDate from '~/components/FormattedDate.astro';

const PAGE_TITLE_ID = '_top';

const isBlogPost =
  Astro.url.pathname.startsWith('/blog/') &&
  Astro.url.pathname !== '/blog/';

const meta = Astro.locals.blogMeta;
---

{isBlogPost && meta ? (
  <div class="blog-header-meta">
    {meta.heroImage && (
      <Image
        src={meta.heroImage}
        alt="Blog Hero Image"
        class="hero-image"
      />
    )}

    {meta.pubDate && (
      <div class="date">
        <FormattedDate date={meta.pubDate} />
      </div>
    )}

    <h1 id={PAGE_TITLE_ID}>{Astro.locals.starlightRoute.entry.data.title}</h1>

    {meta.author && (
      <div class="sl-flex author">
        <span>{Astro.locals.t('component.blogPostAuthor')}</span>
        <img
          src={meta.author.avatar}
          alt={meta.author.name}
          class="avatar"
        />
        <span set:html={meta.author.name} />
      </div>
    )}
  </div>
) : (
  <Default />
)}

<style>
  @layer starlight.core {
    @media (min-width: 50em) {
    	h1 {
			font-size: var(--sl-text-3xl);
		}
	}
	h1 {
		margin-top: 1rem;
		font-size: var(--sl-text-4xl);
		line-height: var(--sl-line-height-headings);
		font-weight: 500;
		color: var(--sl-color-white);
	}
    .blog-header-meta {
      text-align: center;
      justify-items: center;
      width: 100%;
    }

    .hero-image {
      width: 100%;
      height: auto;
      max-height: 400px;
      object-fit: cover;
      /* border-radius: 0.5rem; disabled rounded*/
      margin-bottom: 1.25rem;
    }

    .date {
      font-size: var(--sl-text-base);
      color: var(--sl-color-gray-2);
      margin-bottom: 0.75rem;
    }

    .author {
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.75rem;
      font-size: var(--sl-text-base);
      color: var(--sl-color-gray-1);
    }

    .avatar {
      width: 1.5rem;
      height: 1.5rem;
      border-radius: 50%;
      object-fit: cover;
      border: 1px solid var(--sl-color-hairline);
    }
  }
</style>