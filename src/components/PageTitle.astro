---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { Image } from 'astro:assets';
import FormattedDate from '~/components/FormattedDate.astro';

const route = Astro.locals.starlightRoute;
const data = route?.entry?.data;
const isBlogDetail = Astro.url.pathname.startsWith('/blog/') && Astro.url.pathname !== '/blog/';

const title = data?.title;
const pubDate = data?.pubDate;
const heroImage = data?.heroImage;
const author = data?.author || { name: 'c0desk1', avatar: 'https://avatars.githubusercontent.com/u/81931118?v=4' };
---

{isBlogDetail ? (
	<div class="blog-header-meta">
		<Default>
			{heroImage && (
				<Image src={heroImage} alt={title} class="hero-image" />
			)}
		
			<div class="meta-info">
				{pubDate && <FormattedDate date={new Date(pubDate)} />}
			</div>
		
			<slot />
			<div class="author-info">
				<span class="dot">By</span>
				<img src={author.avatar} alt={author.name} class="author-avatar" />
				<span class="author-name">{author.name}</span>
			</div>
		</Default>
	</div>
) : (
	<Default>
		<slot />
	</Default>
)}

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
		.blog-header-meta {
			margin-bottom: 1.5rem;
		}
		.blog-header-meta h1 {
			margin-top: 0.75rem;
			margin-bottom: 0;
		}
		.hero-image {
			width: 100%;
			height: auto;
			max-height: 400px;
			object-fit: cover;
			border-radius: 0.5rem;
			margin-bottom: 1rem;
		}
		.meta-info {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}
		.author-info {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}
		.author-avatar {
			width: 24px;
			height: 24px;
			border-radius: 50%;
			object-fit: cover;
		}
		.author-name {
			color: var(--sl-color-gray-2);
			font-weight: 500;
		}
		.dot {
			color: var(--sl-color-gray-4);
		}
	}
</style>