---
// 1. Import the default Hero, not PageTitle
import Default from '@astrojs/starlight/components/Hero.astro';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';

const { entry } = Astro.locals.starlightRoute;
const { title, pubDate, heroImage, author } = entry.data;

const isBlogPost = Astro.url.pathname.startsWith('/blog/');

const PAGE_TITLE_ID = '_top';
---
{isBlogPost ? (
  <div class="mx-auto w-full max-w-5xl md:-mb-20 lg:-mb-24 xl:-mb-32 aspect-video">
    {heroImage && (
      <Image width={1500} height={643} src={heroImage} class="min-h-60 h-auto w-full object-cover" alt={title} loading="eager" decoding="async" />
    )}
  </div>
  <header class="mx-auto w-full max-w-prose text-center bg-(--sl-color-bg) md:z-10 relative p-6">
    {pubDate && <FormattedDate date={pubDate} class="post-date" />}
    <h1 id={PAGE_TITLE_ID} class="post-title mb-4 mt-2 sm:mb-5 sm:mt-3">{title}</h1>
    {author && (
      <div class="post-author flex flex-wrap items-center justify-center gap-x-4 text-(--sl-color-gray-2) md:gap-y-4">
        <span>{Astro.locals.t('component.blogPostAuthor')}</span>
        <div class="flex items-center gap-2">
          { author.avatar && (
            <Image 
              src={author.avatar} 
              width={48} 
              height={48}
              class="my-0 inline-block rounded-full border border-(--sl-color-accent) size-6 md:size-10" 
              alt={author.name || title } 
              loading="lazy" 
              decoding="async" 
              aria-hidden="true"
            />
          )} 
          <span>{author.name}</span>
        </div>
      </div>
    )}
  </header>
) : (
    <Default {...Astro.props} />
)}

<style>
  .post-title {
    font-size: var(--sl-text-h3);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
    text-align: center;
  }
  .post-date,
  .post-author {
    font-size: var(--sl-text-body);
    font-weight: 500;
    line-height: var(--sl-line-height);
    color: var(--sl-color-gray-2);
    font-family: var(--__sl-font-mono);
  }

  @media (min-width: 50rem) {
  	.post-title {
      font-size: var(--sl-text-h2);
    }
	}
</style>

<style is:global>
  .content-panel .sl-container header {
    max-width: 52rem !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative;
    z-index: 10;
  }
  .content-panel + .content-panel {
		border-top: 1px solid var(--sl-color-gray-5);
    max-width: 52rem !important;
    margin-inline: auto;
	}
  @media (min-width: 50rem) {
    .main-frame {
      padding-top: calc(var(--sl-nav-height) - 10%);
    }
  }
</style>