---
// Hero.astro
import Default from '@astrojs/starlight/components/Hero.astro';

const { entry } = Astro.locals.starlightRoute;
const { title, hero } = entry.data;

const pathname = Astro.url.pathname;

const isBlogIndex = pathname === '/blog/' || pathname === '/blog' || 
                    pathname === '/id/blog/' || pathname === '/id/blog';


const PAGE_TITLE_ID = '_top';
---

{isBlogIndex ? (
  <div class="lg:py-18 blog-index-wrapper relative z-10 py-12 sm:py-14 md:py-16 xl:py-20 border-b border-(--sl-color-gray-5)">
    <div class="absolute inset-x-0 top-0 h-px w-full bg-linear-to-r from-transparent via-(--sl-color-accent-high) to-transparent opacity-50" />
    <div class="pointer-events-none absolute inset-0 z-0 bg-[linear-gradient(rgba(128,128,128,0.1)_1px,transparent_1px),linear-gradient(90deg,rgba(128,128,128,0.1)_1px,transparent_1px)] mask-[radial-gradient(ellipse_80%_80%_at_50%_0%,#000_40%,transparent_100%)] bg-size-[24px_24px]" />
    <div class="relative flex flex-col flex-1 items-center gap-6 text-center z-20">
      <h1 id={PAGE_TITLE_ID} class="blog-index-title mx-auto max-w-5xl text-(--sl-text-h3) sm:text-(--sl-text-h2) lg:text-(--sl-text-h1)" set:html={hero?.title || title} />
      {hero?.tagline && <p class="blog-index-tagline text-(--sl-color-gray-2)" set:html={hero.tagline} />}
    </div>
  </div>
) : (
    <Default {...Astro.props} />
)}

<style>
  /* --- Blog Index Styles --- */
  .blog-index-wrapper {
    row-gap: 6rem;
    width: 100%;
    padding-bottom: 6rem;
    display: grid;
    overflow: clip;
  }

  .blog-index-hero {
    position: relative;
    text-align: center;
    z-index: 20;
  }

  .blog-index-title{
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
    margin: 0;
  }

  .blog-index-tagline {
    --sans-wght: 300;
    -webkit-font-smoothing: subpixel-antialiased;

    font-size: var(--sl-text-body);
    font-weight: 300;
    line-height: var(--sl-line-height);
  }

  /* --- Blog Post Styles --- */
  .post-title {
    font-size: var(--sl-text-h3);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
    text-align: center;
  }
  .post-date,
  .post-author {
    font-size: var(--sl-text-body);
    font-weight: 500;
    line-height: var(--sl-line-height);
    color: var(--sl-color-gray-2);
    font-family: var(--__sl-font-mono);
  }

  @media (min-width: 50rem) {
    .post-title {
      font-size: var(--sl-text-h2);
    }
    
    .blog-index-hero .blog-index-title {
      font-size: var(--sl-text-h1)
    }
  }
</style>

<style is:global>
  .content-panel .sl-container header {
    max-width: 52rem !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative;
    z-index: 10;
  }
  .content-panel + .content-panel {
    border-top: 1px solid var(--sl-color-gray-5);
    max-width: 52rem !important;
    margin-inline: auto;
  }
</style>