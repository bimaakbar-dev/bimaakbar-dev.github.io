---
import Default from '@astrojs/starlight/components/Hero.astro';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';

const { entry } = Astro.locals.starlightRoute;
const { title, pubDate, heroImage, author, hero } = entry.data;

const pathname = Astro.url.pathname;

const isBlogIndex = pathname === '/blog' || pathname === '/blog/';
const isBlogPost = pathname.startsWith('/blog/') && !isBlogIndex;

const PAGE_TITLE_ID = '_top';
---

{isBlogIndex ? (
  <div class="blog-index-wrapper">
    <div class="blog-index-hero">
      <h1 id={PAGE_TITLE_ID}>{hero?.title || title}</h1>
      {hero?.tagline && <p class="tagline">{hero.tagline}</p>}
    </div>
  </div>
) : isBlogPost ? (
  <>
    <div class="mx-auto w-full max-w-5xl md:-mb-20 lg:-mb-24 xl:-mb-32 aspect-video">
      {heroImage && (
        <Image width={1500} height={643} src={heroImage} class="min-h-60 h-auto w-full object-cover" alt={title} loading="eager" decoding="async" />
      )}
    </div>
    <header class="mx-auto w-full max-w-prose text-center bg-(--sl-color-bg) md:z-10 relative p-6">
      {pubDate && <FormattedDate date={pubDate} class="post-date" />}
      <h1 id={PAGE_TITLE_ID} class="post-title mb-4 mt-2 sm:mb-5 sm:mt-3">{title}</h1>
      {author && (
        <div class="post-author flex flex-wrap items-center justify-center gap-x-4 text-(--sl-color-gray-2) md:gap-y-4">
          <span>{Astro.locals.t('component.blogPostAuthor')}</span>
          <div class="flex items-center gap-2">
            { author.avatar && (
              <Image 
                src={author.avatar} 
                width={48} 
                height={48}
                class="my-0 inline-block rounded-full border border-(--sl-color-accent) size-6 md:size-10" 
                alt={author.name || title } 
                loading="lazy" 
                decoding="async" 
                aria-hidden="true"
              />
            )} 
            <span>{author.name}</span>
          </div>
        </div>
      )}
    </header>
  </>
) : (
    <Default {...Astro.props} />
)}

<style>
  /* --- Blog Index Styles --- */
  .blog-index-wrapper {
    margin-inline: -var(--sl-content-pad-x);
    padding: 5rem var(--sl-content-pad-x);
    background-color: var(--sl-color-bg);
    background-image: 
      radial-gradient(circle at 50% 50%, rgba(120, 119, 198, 0.15) 0%, transparent 60%),
      linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 100% 100%, 40px 40px, 40px 40px;
    border-bottom: 1px solid var(--sl-color-gray-5);
    margin-bottom: 3rem;
  }

  .blog-index-hero {
    text-align: center;
    max-width: 64rem;
    margin: 0 auto;
  }

  .blog-index-hero h1 {
    font-size: var(--sl-color-h1);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
    margin-bottom: 1rem;
  }

  .blog-index-hero .tagline {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-3);
    line-height: var(--sl-line-height);
  }

  /* --- Blog Post Styles --- */
  .post-title {
    font-size: var(--sl-text-h3);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
    text-align: center;
  }
  .post-date,
  .post-author {
    font-size: var(--sl-text-body);
    font-weight: 500;
    line-height: var(--sl-line-height);
    color: var(--sl-color-gray-2);
    font-family: var(--__sl-font-mono);
  }

  @media (min-width: 50rem) {
    .post-title {
      font-size: var(--sl-text-h2);
    }
  }
</style>

<style is:global>
  .content-panel .sl-container header {
    max-width: 52rem !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative;
    z-index: 10;
  }
  .content-panel + .content-panel {
    border-top: 1px solid var(--sl-color-gray-5);
    max-width: 52rem !important;
    margin-inline: auto;
  }
/* @media (min-width: 50rem) {
    .main-frame {
      padding-top: calc(var(--sl-nav-height) - 10%);
    }
  }
*/
</style>