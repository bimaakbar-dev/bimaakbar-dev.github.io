---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('docs');

const blogPosts = allPosts
  .filter((post) => post.data.pubDate)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const getUrl = (id: string) => {
  const base = id.replace(/\.(md|mdx)$/, '').replace(/\/index$/, '');
  return `/${base}`;
};
---

<div class="post-grid">
  {
    blogPosts.map((post) => {
      const { data, id } = post;
      const { title, description, pubDate, heroImage } = data;
      const formattedDate = pubDate
        ? pubDate.toLocaleDateString('id-ID', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        : null;

      return (
        <a href={getUrl(id)} class="post-card">
          <div class="post-card-content">
            {formattedDate && (
              <time datetime={pubDate.toISOString()} class="post-card-date">
                {formattedDate}
              </time>
            )}
            {heroImage && (
            <div class="post-card-image">
              <Image src={heroImage} alt={title} loading="lazy" />
            </div>
          )}
            <h3 class="post-card-title">{title}</h3>
            {description && <p class="post-card-description">{description}</p>}
          </div>
        </a>
      );
    })
  }
</div>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .post-card {
    display: block;
    border: 1px solid var(--sl-color-gray-5);
    /* border-radius: 0.75rem; */
    overflow: hidden;
    text-decoration: none;
    color: var(--sl-color-text);
    background-color: var(--sl-color-bg);
    transition: box-shadow 0.25s ease, transform 0.15s ease;
  }

  .post-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  .post-card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--sl-color-gray-6);
  }

  .post-card-image > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    border-radius; none !important;
  }

  .post-card-content {
    padding-block: 1.25rem;
  }

  .post-card-date {
    display: block;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.4rem;
    padding-inline: 1.25rem;
  }

  .post-card-title {
    margin: 0 0 0.4rem 0;
    font-size: var(--sl-text-h4);
    font-weight: 500;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-text);
   padding-inline: 1.25rem;
  }

  .post-card-description {
    margin: 0;
    font-size: var(--sl-text-body);
    color: var(--sl-color-gray-2);
    line-height: var(--sl-line-height);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    padding-inline: 1.25rem;
  }
</style>