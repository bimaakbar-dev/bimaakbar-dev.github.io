---
// src/components/PostCard.astro
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

const route = Astro.locals.starlightRoute as any;
const { blogPrefix, blogBasePath } = route;

const allPosts = await getCollection("docs", ({ id, data }) => {
  if (data.draft) return false;
  return id.startsWith(blogPrefix);
});

const blogPosts = allPosts
  .filter(
    (post): post is typeof post & { data: { pubDate: Date } } =>
      post.data.pubDate !== undefined,
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const $ = {
  card: [
    "not-content",
    "relative flex flex-col h-full",
    "p-4",
    "border",
    "bg-(--sl-color-gray-6) border-(--sl-color-gray-5) outline-(--sl-color-accent-high)",
    "hover:scale-[1.03]",
    "focus-within:outline",
    "transition-transform duration-300 ease-out",
  ].join(" "),
  cardHeader: "post-card-date",
  cardDate: "post-card-date text-(--sl-color-gray-2)",
  cardCover: "-mx-4 my-4",
  cardImage: ["size-full object-cover"].join(" "),
  cardContent: [
    "grid md:grid-cols-2",
    "flex-1",
    "mt-auto gap-x-16 gap-y-8",
  ].join(" "),
  cardContentTitle: "post-card-title text-(--sl-color-white)",
  cardTitle: ["outline-none", "after:absolute after:inset-0"].join(" "),
  cardDesc: "post-card-description text-(--sl-color-gray-2)",
};
---

{
  blogPosts.map((post) => {
    const { data } = post;
    const { title, description, pubDate, heroImage } = data;
    const slug = post.id.slice(blogPrefix.length);
    const href = `${blogBasePath}/${slug}`;

    return (
      <li class="w-full">
        <article class={$.card}>
          <header>
            <FormattedDate class={$.cardDate} date={pubDate} />
          </header>
          <div class={$.cardCover}>
            {heroImage && (
              <Image
                width={766}
                height={328}
                src={heroImage}
                class={$.cardImage}
                alt={title}
                loading="eager"
                decoding="async"
              />
            )}
          </div>
          <div class={$.cardContent}>
            <h3 class={$.cardContentTitle}>
              <a href={href} class={$.cardTitle}>
                {title}
              </a>
            </h3>
            {description && <p class={$.cardDesc}>{description}</p>}
          </div>
        </article>
      </li>
    );
  })
}

<style>
  .post-card-date {
    font-family: var(--__sl-font-mono);
  }

  .post-card-title {
    font-size: var(--sl-text-h4);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    text-align: start;
  }

  .post-card-title a {
    font-size: inherit;
    line-height: inherit;
    font-weight: inherit;
    color: var(--sl-color-white);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .post-card-description {
    font-size: var(--sl-text-body);
    line-height: var(--sl-line-height);
    text-align: start;
    margin: 0;
  }

  @media (min-width: 50rem) {
    .post-card-title {
      font-size: var(--sl-text-h3);
    }
  }
</style>
