---
// src/components/PostCard.astro
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

const route = Astro.locals.starlightRoute as any;
const { blogPrefix, blogBasePath } = route;

const allPosts = await getCollection("docs", ({ id, data }) => {
  if (data.draft) return false;
  return id.startsWith(blogPrefix);
});

const blogPosts = allPosts
  .filter(
    (post): post is typeof post & { data: { pubDate: Date } } =>
      post.data.pubDate !== undefined,
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

{
  blogPosts.map((post, index) => {
    const { data } = post;
    const { title, description, pubDate, cover } = data;

    const isAboveFold = index < 5;
    const imageAttrs = {
      loading: (isAboveFold ? 'eager' : 'lazy') as 'eager' | 'lazy',
      decoding: 'async' as const,
      fetchpriority: (isAboveFold ? 'high' : 'low') as 'high' | 'low',
      width: 766,
      height: 328,
    };

    const alt = cover?.alt || title || "";
    const slug = post.id.slice(blogPrefix.length);
    const href = `${blogBasePath}/${slug}`;

    return (
      <li class="not-content">
        <article class="post-card">
          <header>
            <FormattedDate class="date" date={pubDate} />
          </header>
          <div class="cover">
            {cover?.image &&
              (typeof cover.image === 'string' ? (
                <img
                  src={cover.image}
                  {...imageAttrs}
                  alt={alt}
                  class="sl-block"
                />
              ) : (
                <Image
                  src={cover.image}
                  {...imageAttrs}
                  alt={alt}
                  quality="high"
                  fit="cover"
                  position="center"
                  class="sl-block"
                />
              ))}
          </div>
          <div class="content">
            <h3>
              <a href={href}>{title}</a>
            </h3>
            {description && <p>{description}</p>}
          </div>
        </article>
      </li>
    );
  })
}

<style>
  li {
    width: 100%;
    list-style: none;
    padding: 0;
  }
  li:focus-within .post-card {
    outline-color: var(--sl-color-accent-high);
  }
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.25em;
    border-radius: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
    outline: 1px solid transparent;
  }
  .post-card header .date {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-base);
    color: var(--sl-color-gray-2);
  }

  .post-card .cover {
    margin: 1em -1.25em;
    overflow: hidden;
  }

  .post-card .cover img {
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: opacity 140ms ease;
  }

  .post-card .content {
    display: flex;
    flex-direction: column;
    flex: 1;
    margin-top: 1em;
    gap: 0.75em;
  }

  .post-card .content h3 {
    font-size: var(--sl-text-h4);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
    margin: 0;
  }

  .post-card .content h3 a {
    font-size: inherit;
    line-height: inherit;
    font-weight: inherit;
    color: inherit;
    text-decoration: none;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  .post-card .content h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-card .content p {
    font-size: var(--sl-text-body);
    color: var(--sl-color-gray-2);
    margin: 0;
  }

  [data-theme='light'] .post-card {
    box-shadow: var(--shadow-float);
    border: none;
  }

  @media (min-width: 50rem) {
    .post-card .content {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1em 1.5em;
      align-items: start;
      margin-top: 0;
    }

    .post-card .content h3 {
      font-size: var(--sl-text-h3);
    }
  }

  @media (hover: hover) {
    .post-card:hover {
      background: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card {
      transition: none;
    }
  }
</style>
