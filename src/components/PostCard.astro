---
import FormattedDate from './FormattedDate.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('docs');

const blogPosts = allPosts
  .filter((post) => post.data.pubDate)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const getUrl = (id: string) => {
  const base = id.replace(/\.(md|mdx)$/, '').replace(/\/index$/, '');
  return `/${base}`;
};
---

<div class="post-grid">
  {
    blogPosts.map((post) => {
      const { data, id } = post;
      const { title, description, pubDate, heroImage } = data;
      return (
        <article class="post-card">
			<header>
            	<p class="post-card-date">
					<FormattedDate date={pubDate} />
            	</p>
			</header>
			<div class="post-card-cover">
              {heroImage && (
			    <Image width={766} height={328} src={heroImage} class="post-card-image" alt={title} loading="lazy" />
              )}
            </div>
            <h3 class="post-card-title">
				<a href={getUrl(id)}>{title}</a>
			</h3>
            {description && <p class="post-card-description">{description}</p>}
        </article>
      );
    })
  }
</div>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .post-card {
    position: relative;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    /* border-radius: 0.75rem; */
    background-color: var(--sl-color-bg);
    transition: box-shadow 0.25s ease, transform 0.15s ease;
  }

  .post-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }
  
  .post-card-cover {
    margin-inline: -1rem;
  }

  .post-card-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform 0.3s ease;
    aspect-ratio: 16 / 9;
    background-color: var(--sl-color-gray-6);
    border: none;
    margin-block: 1rem;
  }

  .post-card-date {
    font-size: var(--sl-text-body);
    line-height: var(--sl-line-height);
    color: var(--sl-color-gray-2);
    font-family: var(--__sl-font-mono);
  }

  .post-card-title {
    font-size: var(--sl-text-h4);
    font-weight: 500;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-text);
	margin-bottom: 1rem;
	text-decoration: none;
  }

  .post-card-description {
    margin: 0;
    font-size: var(--sl-text-body);
    color: var(--sl-color-gray-2);
    line-height: var(--sl-line-height);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }
</style>