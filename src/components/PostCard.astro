---
import FormattedDate from './FormattedDate.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('docs');

const blogPosts = allPosts
  .filter((post): post is typeof post & { data: { pubDate: Date } } =>
    post.data.pubDate !== undefined
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

{ blogPosts.map((post) => {
    const { data } = post;
    const { title, description, pubDate, heroImage } = data;
    return (
      <article class="relative border border-(--sl-color-gray-5) bg-(--sl-color-gray-6) p-4 outline-(--sl-color-purple) transition-transform duration-300 ease-out focus-within:outline hover:scale-[1.03]">
        <header>
          <FormattedDate class="font-mono text-(--sl-color-gray-2)" date={pubDate} />
        </header>
        <div class="-mx-4">
          {heroImage && (
            <Image width={766} height={328} src={heroImage} class="my-4 w-full h-auto" alt={title} loading="lazy" decoding="async" />
          )}
        </div>
        <div class="mt-6 grid gap-x-16 gap-y-4 md:grid-cols-2">
          <h3 class="post-card-title">
            <a href={`/${post.id}/`} class="outline-none after:absolute after:inset-0">{title}</a>
          </h3>
          {description && <p class="post-card-description">{description}</p>}
        </div>
      </article>
    );
  })
}

<style>
  .post-card-title {
    font-size: var(--sl-text-h4);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-text);
    text-align: start;
  }
  
  .post-card-title a {
  	text-decoration: none;
  }

  .post-card-description {
    font-size: var(--sl-text-body);
    color: var(--sl-color-gray-2);
    line-height: var(--sl-line-height);
    text-align: start;
    margin: 0;
  }

  @media (min-width: 50rem) {
  	.post-card-title {
      font-size: var(--sl-text-h3);
    }
	}
</style>