---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

const allPosts = await getCollection('docs');

const blogPosts = allPosts
  .filter((post): post is typeof post & { data: { pubDate: Date } } =>
    post.data.pubDate !== undefined
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  
const $ = {
  card: [
    'relative flex flex-col h-full',
    'p-4',
    'border',
    'bg-(--sl-color-gray-6) border-(--sl-color-gray-5) outline-(--sl-color-purple)',
    'hover:scale-[1.03]',
    'focus-within:outline',
    'transition-transform duration-300 ease-out',
  ].join(' '),
  cardHeader: 'post-card-date',
  cardDate: 'post-card-date text-(--sl-color-gray-2)',
  cardCover: '-mx-4 my-4',
  cardImage: [
    'size-full object-cover',
  ].join(' '),
  cardContent: [
    'grid md:grid-cols-2',
    'flex-1',
    'mt-auto gap-x-16 gap-y-8'
  ].join(' '),
  cardContentTitle: 'post-card-title text-(--sl-color-text)',
  cardTitle: [
    'outline-none',
    'after:absolute after:inset-0',
  ].join(' '),
  cardDesc: 'post-card-description text-(--sl-color-gray-2)',
};
  
---

{ blogPosts.map((post) => {
    const { data } = post;
    const { title, description, pubDate, heroImage } = data;
    return (
      <article class={$.card}>
        <header>
          <FormattedDate class={$.cardDate} date={pubDate} />
        </header>
        <div class={$.cardCover}>
          {heroImage && (
            <Image width={766} height={328} src={heroImage} class={$.cardImage} alt={title} loading="lazy" decoding="async" />
          )}
        </div>
        <div class={$.cardContent}>
          <h3 class={$.cardContentTitle}>
            <a href={`/${post.id}/`} class={$.cardTitle}>{title}</a>
          </h3>
          {description && <p class={$.cardDesc}>{description}</p>}
        </div>
      </article>
    );
  })
}

<style>
  .post-card-date {
  	font-family: var(--__sl-font-mono);
   }
   
  .post-card-title {
    font-size: var(--sl-text-h4);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    text-align: start;
  }
  
  .post-card-title a {
  	text-decoration: none;
  -webkit-tap-highlight-color: transparent;
  }

  .post-card-description {
    font-size: var(--sl-text-body);
    line-height: var(--sl-line-height);
    text-align: start;
    margin: 0;
  }

  @media (min-width: 50rem) {
  	.post-card-title {
      font-size: var(--sl-text-h3);
    }
	}
</style>