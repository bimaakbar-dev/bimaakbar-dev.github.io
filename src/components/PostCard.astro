---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

export interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { data, id } = entry; // <-- Ambil id (bukan slug)
const { title, description, pubDate, heroImage } = data;

// Ubah id menjadi URL yang valid:
// - Buang ekstensi .md / .mdx
// - Jika ada /index di akhir, buang juga (biar jadi /blog)
const url = `/${id.replace(/\.(md|mdx)$/, '').replace(/\/index$/, '')}`;

const formattedDate = pubDate
  ? pubDate.toLocaleDateString('id-ID', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<a href={url} class="post-card">
  {heroImage && (
    <div class="post-card-image">
      <Image src={heroImage} alt={title} loading="lazy" />
    </div>
  )}
  <div class="post-card-content">
    {formattedDate && (
      <time datetime={pubDate.toISOString()} class="post-card-date">
        {formattedDate}
      </time>
    )}
    <h3 class="post-card-title">{title}</h3>
    {description && <p class="post-card-description">{description}</p>}
  </div>
</a>

<style>
  .post-card {
    display: block;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    overflow: hidden;
    text-decoration: none;
    color: var(--sl-color-text);
    background-color: var(--sl-color-bg);
    transition: box-shadow 0.25s ease, transform 0.15s ease;
  }

  .post-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  .post-card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--sl-color-gray-6);
  }

  .post-card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .post-card:hover .post-card-image :global(img) {
    transform: scale(1.03);
  }

  .post-card-content {
    padding: 1.25rem;
  }

  .post-card-date {
    display: block;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.4rem;
    letter-spacing: 0.02em;
  }

  .post-card-title {
    margin: 0 0 0.4rem 0;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--sl-color-text);
  }

  .post-card-description {
    margin: 0;
    font-size: 0.95rem;
    color: var(--sl-color-gray-2);
    line-height: 1.5;
    /* Batasi deskripsi jadi 3 baris */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>