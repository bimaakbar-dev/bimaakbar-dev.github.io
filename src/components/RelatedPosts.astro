---
// src/components/RelatedPosts.astro
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  currentSlug: string;
  limit?: number;
}

const { currentSlug, limit = 2 } = Astro.props;

const { locale } = Astro.locals.starlightRoute || {};
const currentLocale = locale || 'root';

const localePrefix = currentLocale === 'root' ? 'blog/' : `${currentLocale}/blog/`;

const allPosts = await getCollection('docs', ({ data }) => !data.draft);

const postsInSameLocale = allPosts.filter(p => p.id.startsWith(localePrefix));
const currentPost = postsInSameLocale.find((p) => p.id === currentSlug);
if (!currentPost) return;

const currentTags = currentPost.data.tags || [];

const relatedPosts = postsInSameLocale
  .filter((p) => p.id !== currentSlug)
  .filter((p) => {
    if (currentTags.length === 0) return false;
    return p.data.tags?.some((tag) => currentTags.includes(tag));
  })
  .sort((a, b) => {
    const dateA = a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
    const dateB = b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
    return dateB - dateA;
  })
  .slice(0, limit);

const getHref = (post: { id: string }) => {
  const slug = post.id.replace(/^(id\/)?blog\//, '');
  return currentLocale === 'root' ? `/blog/${slug}` : `/${currentLocale}/blog/${slug}`;
};

const $ = {
  card: [
    'relative flex flex-col h-full',
    'border',
    'bg-(--sl-color-gray-6) border-(--sl-color-gray-5) text-(--sl-color-gray-2) outline-(--sl-color-accent-high)',
    'hover:scale-[1.03]',
    'focus-within:outline',
    'transition-transform duration-300 ease-out',
  ].join(' '),
  cardImage: 'w-full max-h-48 h-auto object-cover',
  cardContent: [
    'related-card-content',
    'flex flex-col',
    'flex-1 gap-4 px-4 py-6',
  ].join(' '),
  cardTitle: [
    'text-(--sl-text-h4) md:text-(--sl-text-h3)',
    'text-pretty outline-none',
    'after:absolute after:inset-0',
  ].join(' '),
  cardDesc: ['mt-auto', 'text-(--sl-color-gray-3)'].join(' '),
};
---

{
  relatedPosts.length > 0 && (
    <>
      <hr />
      <nav aria-labelledby="_related-posts" class="not-content related-post">
        <h2 class="related-label text-(--sl-color-white)">
          {Astro.locals.t('blog.relatedPostLabel')}
        </h2>
        <div class="my-6 grid gap-8 grid-cols-[repeat(auto-fill,minmax(min(100%,18rem),1fr))]">
          {relatedPosts.map((post) => (
            <article class={$.card}>
              {post.data.heroImage && (
                <Image
                  src={post.data.heroImage}
                  alt={post.data.title}
                  width={1000}
                  height={429}
                  loading="lazy"
                  decoding="async"
                  class={$.cardImage}
                />
              )}
              <div class={$.cardContent}>
                <a href={getHref(post)} class={$.cardTitle}>
                  {post.data.title}
                </a>
                {post.data.description && (
                  <p class={$.cardDesc}>{post.data.description}</p>
                )}
              </div>
            </article>
          ))}
        </div>
      </nav>
    </>
  )
}

<style>
  .related-label {
    font-size: var(--sl-text-h3);
    font-weight: 500;
    line-height: var(--sl-line-height-headings);
  }
  .related-card-content a {
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .related-card-content p {
    line-height: var(--sl-line-height);
    margin: 0;
  }
</style>