<style>
  page-actions {
    font-size: var(--sl-text-2xs);
    align-items: center;
    flex-wrap: wrap;
    margin-inline-start: -0.5rem;
    gap: 0.25rem;
    & .divider {
      color: var(--sl-color-hairline);
      user-select: none;
    }
    & .action-link {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.25rem 0.5rem;
      border-radius: 0.35rem;
      color: var(--sl-color-gray-2);
      font-weight: 500;
      text-decoration: none;
      background: transparent;
      border: 0;
      cursor: pointer;
      transition: color 0.3s ease;
      &:focus-visible {
        outline: 2px solid var(--sl-color-accent-high);
        background: var(--sl-color-gray-6);
      }
      &:hover {
        color: var(--sl-color-text-accent);
      }
      &.is-done {
        color: var(--sl-color-text-accent);
      }
    }
  }
  [data-theme="light"] page-actions {
    & .action-link {
      color: var(--sl-color-gray-3);
      &:hover {
        color: var(--sl-color-accent-high);
      }
    }
  }
  @media (min-width: 50rem) {
    page-actions {
      font-size: var(--sl-text-xs);
    }
  }
</style>

<script>
  class PageActions extends HTMLElement {
    connectedCallback() {
      const mdUrl = this.dataset.mdUrl || "";
      this.querySelectorAll<HTMLButtonElement>("button[data-action]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const action = btn.dataset.action;
          const label = btn.querySelector("[aria-live]") as HTMLElement;
          const original = label?.textContent || "";
          try {
            if (action === "copy-url") {
              await navigator.clipboard.writeText(window.location.href);
            } else if (action === "markdown" && mdUrl) {
              const res = await fetch(mdUrl);
              if (!res.ok) throw new Error("Failed to fetch markdown");
              const text = await res.text();
              await navigator.clipboard.writeText(text);
            }
            if (label) {
              btn.classList.add("is-done");
              label.textContent = "Disalin!";
              setTimeout(() => {
                btn.classList.remove("is-done");
                label.textContent = original;
              }, 1600);
            }
          } catch (e) {
            console.error(e);
          }
        });
      });
    }
  }
  if (!customElements.get("page-actions")) {
    customElements.define("page-actions", PageActions);
  }
</script>