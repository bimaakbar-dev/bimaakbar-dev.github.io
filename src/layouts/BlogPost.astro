---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Head from 'virtual:starlight/components/Head';
import Header from 'virtual:starlight/components/Header';
import Footer from 'virtual:starlight/components/Footer';
import SkipLink from 'virtual:starlight/components/SkipLink';
import ThemeProvider from 'virtual:starlight/components/ThemeProvider';
import FormattedDate from '~/components/FormattedDate.astro';
import '~/styles/custom.css';

type Props = CollectionEntry<'blog'>['data'] & {
  author: { name: string; avatar: string };
};

const { title, description, pubDate, updatedDate, heroImage, author } = Astro.props;
---

<html lang="en" dir="ltr" data-theme="dark">
  <head>
    <Head />
    <ThemeProvider />
  </head>
  <body>
    <SkipLink />
    <div class="page">
      <header class="header">
        <Header />
      </header>

      <div class="main-frame">
        <div class="sg-blog-post">

          <aside class="sg-sidebar print:hidden">
            <div class="sg-sidebar-inner">
              <div class="sg-placeholder-block">
                <div class="sg-placeholder-label">Related Posts</div>
                <div class="sg-placeholder-item" />
                <div class="sg-placeholder-item" />
                <div class="sg-placeholder-item" />
              </div>
              <div class="sg-placeholder-block">
                <div class="sg-placeholder-label">CTA</div>
                <div class="sg-placeholder-cta" />
              </div>
            </div>
          </aside>

          <main id="_top" data-pagefind-body>
            <article>
              {heroImage && (
                <div class="hero-image">
                  <Image src={heroImage} alt={title} width={1020} height={510} />
                </div>
              )}

              <div class="prose">
                <div class="post-header">
                  <div class="post-meta">
                    <FormattedDate date={pubDate} />
                    {updatedDate && (
                      <span class="updated">
                        · Updated <FormattedDate date={updatedDate} />
                      </span>
                    )}
                  </div>
                  <h1 id="_top">{title}</h1>
                  <div class="author-info">
                    <img src={author.avatar} alt={author.name} class="author-avatar" />
                    <span class="author-name">{author.name}</span>
                  </div>
                </div>

                <div class="sl-markdown-content">
                  <slot />
                </div>
              </div>
            </article>
          </main>

          <aside class="sg-pagebar print:hidden" aria-hidden="true" />
        </div>
      </div>

      <Footer />
    </div>
  </body>
</html>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .header {
    position: fixed;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 100%;
    height: var(--sl-nav-height);
    z-index: var(--sl-z-index-navbar);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    background-color: var(--sl-color-bg-nav);
  }

  .main-frame {
    padding-top: var(--sl-nav-height);
    flex: 1;
  }

  .sg-blog-post {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    min-height: calc(100vh - var(--sl-nav-height));
  }

  main {
    order: 1;
    width: 100%;
  }

  .sg-sidebar {
    order: 2;
    display: block;
    border-top: 0.5px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-sidebar);
    overflow-y: auto;
  }

  .sg-pagebar {
    display: none;
  }

  /* Hero image */
  .hero-image {
    width: 100%;
  }

  .hero-image img {
    display: block;
    width: 100%;
    max-height: 400px;
    object-fit: cover;
  }

  /* Prose */
  .prose {
    width: 100%;
    max-width: var(--sl-content-width, 48rem);
    margin-inline: auto;
    padding: 2rem var(--sl-nav-pad-x);
  }

  .post-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 0.5px solid var(--sl-color-hairline);
  }

  .post-meta {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    margin-bottom: 0.75rem;
  }

  .updated {
    font-style: italic;
  }

  .post-header h1 {
    font-size: clamp(var(--sl-text-2xl), calc(0.25rem + 4vw), var(--sl-text-4xl));
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
    margin: 0.5rem 0 1rem;
  }

  .author-info {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .author-avatar {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--sl-color-hairline);
  }

  .author-name {
    font-weight: 500;
  }

  /* Sidebar inner */
  .sg-sidebar-inner {
    padding-inline: var(--sl-sidebar-pad-x);
    padding-block: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sg-placeholder-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sg-placeholder-label {
    font-size: var(--sl-text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-gray-3);
  }

  .sg-placeholder-item {
    height: 0.75rem;
    border-radius: 0.25rem;
    background: var(--sl-color-gray-5);
    width: 100%;
    opacity: 0.5;
  }

  .sg-placeholder-cta {
    height: 2.5rem;
    border-radius: 0.5rem;
    background: var(--sl-color-gray-5);
    opacity: 0.5;
  }

  @media (min-width: 50rem) {
    .sg-blog-post {
      grid-template-columns: var(--sl-sidebar-width) minmax(0, 1fr) var(--sl-sidebar-width);
    }

    main {
      order: 2;
    }

    .sg-sidebar {
      order: 1;
      position: sticky;
      top: var(--sl-nav-height);
      height: calc(100vh - var(--sl-nav-height));
      border-top: none;
      border-inline-end: 0.5px solid var(--sl-color-hairline);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    .sg-pagebar {
      display: block;
      order: 3;
      position: sticky;
      top: var(--sl-nav-height);
      height: calc(100vh - var(--sl-nav-height));
      border-inline-start: 0.5px solid var(--sl-color-hairline);
    }
  }
</style>