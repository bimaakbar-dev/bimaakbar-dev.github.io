---
// NavLinks.astro
import HeaderLink from "./HeaderLink.astro";

const { docsBasePath, blogBasePath } = Astro.locals.starlightRoute;
const t = Astro.locals.t;
---

<nav class="sl-flex">
  <HeaderLink href={`${docsBasePath}`} matchPrefix>
    {t("nav.docs")}
  </HeaderLink>
  <HeaderLink href={`${blogBasePath}`} matchPrefix>
    {t("nav.blog")}
  </HeaderLink>
</nav>

<style>
  nav {
    gap: 0.5rem;
    align-items: center;
  }
  @media (max-width: 50em) {
    nav {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding-block: 1rem;
      width: 100%;
      gap: 1.5em;
    }
  }
</style>