---
import config from 'virtual:starlight/user-config';
import { Icon } from "@astrojs/starlight/components";
import SocialIcons from "./SocialIcons.astro";

const { 
  siteTitle, 
  siteTitleHref, 
  safeLocale
} = Astro.locals.starlightRoute;

const localize = (path: string): string => {
  if (safeLocale === 'root') return path;
  const clean = path.startsWith('/') ? path : `/${path}`;
  return `/${safeLocale}${clean}`;
};

const t = Astro.locals.t;
const currentYear = new Date().getFullYear();
---
<footer class="sl-flex">
  <div class="site-footer sl-flex">
    <div class="site-footer__social">
      <SocialIcons />
      <p class="sl-flex">
        <a href={localize('/privacy/')}>{t('footer.privacy')}</a>
        <span>|</span>
        <a href={localize('/terms/')}>{t('footer.terms')}</a>
      </p>
    </div>
    <div class="site-footer__credits">
      <p>
        <a class="kudos" href={siteTitleHref}>
          {siteTitle}
        </a>
        <time class="copyright">© {currentYear}</time>
      </p>
      {config.credits && (
        <p>
          <a class="kudos" href="https://starlight.astro.build">
            <Icon name="starlight" />
            {Astro.locals.t('builtWithStarlight.label')}
          </a>
        </p>
      )}
    </div>
  </div>
</footer>

<style>
  footer {
    flex-direction: column;
    gap: 2rem;
    max-width: 50rem;
    margin-inline: auto;
    width: 100%;
    padding-block-start: 1.5rem;
  }

  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    width: 100%;
  }

  .site-footer__social {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
    & p {
      align-items: center;
      gap: 0.5em;
      font-size: var(--sl-text-xs);
      color: var(--sl-color-gray-3);
      & a {
        text-decoration: none;
        display: inline-block;
        color: inherit;
        &:hover {
          color: var(--sl-color-white);
        }
      }
    }
  }

  .site-footer__credits {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: var(--sl-text-xs);
  }

  .kudos {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    text-decoration: none;
    color: var(--sl-color-gray-3);
    line-height: var(--sl-line-height);
    transition: color 0.15s ease;
  }

  .kudos :global(svg) {
    color: var(--sl-color-orange);
  }

  .kudos:hover {
    color: var(--sl-color-white);
  }

  .copyright {
    color: var(--sl-color-gray-3);
    margin-inline-start: 0.25em;
  }

  @media (max-width: 50rem) {
    .site-footer__nav {
      flex-direction: column;
      gap: 1.5rem;
	  width: 100%;
    }

    .site-footer__bottom {
      flex-direction: column;
      align-items: center;
    }

    .site-footer__social {
      flex-direction: column;
    }

    .site-footer__credits {
      justify-content: center;
    }
  }
</style>