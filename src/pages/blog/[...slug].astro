---
// src/pages/blog/[...slug].astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allEntries = await getCollection("docs");
  const blogEntries = allEntries.filter(entry => entry.id.startsWith('blog/'));

  return blogEntries.map((entry) => {
    const slug = entry.id.replace(/^blog\//, '');
    return {
      params: { slug },
      props: { entry },
   };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<StarlightPage hasSidebar={false} frontmatter={{
  title: entry.data.title,
  description: entry.data.description,
  editUrl: 'https://github.com/bimaakbar-dev/starlight/edit/main/docs/blog/',
  template: 'doc',
  heroImage: entry.data.heroImage,
  pubDate: entry.data.pubDate,
  author: {
    name: entry.data.author?.name,
    avatar: entry.data.author?.avatar
  },
  lastUpdated: entry.data.lastUpdated,
  draft: entry.data.draft,
  tableOfContents: false,
  tags: entry.data.tags
}}>

  <Content />
</StarlightPage>


<style is:global>
  :root {
    --sg-blog-content-width: 48rem;
    --sg-blog-content-pad-x: var(--sl-content-pad-x);
  }

  .main-frame {
    padding-top: 0;
  }

  .content-panel {
    max-width: 100dvw;
    width: 100%;
    margin-inline: auto;
    padding-left: 0;
    padding-right: 0;
  }

  .content-panel + .content-panel {
    border-top: 1px solid var(--sl-color-gray-5);
    max-width: 100dvw;
    margin-inline: auto;
    margin-block: 0
  }

  .content-panel .sl-container .sl-markdown-content {
    width: 100%;
    max-width: var(--sg-blog-content-width);
    margin-inline: auto;
    padding-inline: var(--sg-blog-content-pad-x);
  }

  .content-panel .sl-container nav.related-post {
    width: 100%;
    max-width: var(--sg-blog-content-width);
    margin-inline: auto;
    padding-inline: var(--sg-blog-content-pad-x);
  }

  .content-panel .sl-container div.meta {
    width: 100%;
    max-width: var(--sg-blog-content-width);
    margin-inline: auto;
    padding-inline: var(--sg-blog-content-pad-x);
  }

  .content-panel .sl-container hr {
    width: 100%;
    border-top: 1px solid var(--sl-color-gray-5);
    margin-inline: auto;
  }
</style>