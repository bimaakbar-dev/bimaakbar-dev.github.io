---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Image } from 'astro:assets';
import FormattedDate from '~/components/FormattedDate.astro';

const posts = await getCollection('blog');

const sorted = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<StarlightPage
  frontmatter={{
    title: 'Stargazer Blog',
    description: 'Get all the latest news from the Stargazers.',
    template: 'splash',
    hero: {
    	tagline: 'Get all the latest news from the Stargazers.'
    },
  }}
>

  <div class="blog-list">
    {sorted.map((post) => (
      <a href={`/blog/${post.id}`} class="post-card">
        <p class="post-meta">
			<FormattedDate date={post.data.pubDate} />
        </p>
		{post.data.heroImage && (
          <Image
            src={post.data.heroImage}
            alt={post.data.title}
            class="post-thumbnail"
          />
        )}
        <div class="post-body">
          <h2 class="post-title" set:html={post.data.title} />
          <p class="post-desc" set:html={post.data.description} />
        </div>
      </a>
    ))}
  </div>
</StarlightPage>

<style>
	.blog-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

    .post-card {
      display: flex;
      flex-direction: column;
      border: 0.5px solid var(--sl-color-hairline);
      background-color: var(--sl-color-gray-6);
      /* border-radius: 0.5rem; */
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      transition: transform 0.2s ease;
    }

    .post-card:hover {
      transform: translateY(-2px);
    }

    .post-thumbnail {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 0 !important;
      margin: 0 !important;
    }

    .post-body {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding: 1rem;
    }

    .post-meta {
      font-size: var(--sl-text-xs);
      color: var(--sl-color-gray-3);
      padding: 1rem;
    }

    .post-title {
		font-size: var(--sl-text-h4);
		font-weight: 500;
		color: var(--sl-color-white);
		line-height: var(--sl-line-height-headings);
    }

    .post-desc {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		line-height: var(--sl-line-height);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>